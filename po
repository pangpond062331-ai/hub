-- ===================== Helpers =====================
local function round2(n) return math.round(n * 100) / 100 end

local function formatVector3(v)
	return "Vector3.new(" .. tostring(round2(v.X)) .. ", " .. tostring(round2(v.Y)) .. ", " .. tostring(round2(v.Z)) .. ")"
end

local function formatDuration(totalSeconds)
	local h = math.floor(totalSeconds / 3600)
	local m = math.floor((totalSeconds % 3600) / 60)
	local s = math.floor(totalSeconds % 60)
	return string.format("%02d:%02d:%02d", h, m, s)
end

local function getMouseHit()
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local loc = UserInputService:GetMouseLocation()
	local ray = cam:ViewportPointToRay(loc.X, loc.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	return workspace:Raycast(ray.Origin, ray.Direction * 5000, params)
end

local function statusString()
	return string.format(
		"📊 วิ่งเร็ว: %s | NoClip: %s | บิน: %s | Boost FPS: %s",
		speedMode and string.format("เปิด[จริง:%.0f/ตั้ง:%d]", (humanoid and humanoid.WalkSpeed or -1), walkSpeedValue) or "ปิด",
		noClipEnabled and "เปิด" or "ปิด",
		flyEnabled and "เปิด" or "ปิด",
		boostBackup and "เปิด" or "ปิด"
	)
end

-- ===================== วิ่งเร็ว (แก้ใหม่) =====================
-- ผูกตัวดักกับ Humanoid: ถ้ามีใครแก้ WalkSpeed ให้เขียนค่าที่ตั้งกลับทันที
local function bindHumanoid(h)
	if walkConnection then walkConnection:Disconnect() walkConnection = nil end
	if not h then return end
	walkConnection = h:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
		if speedMode and h.WalkSpeed ~= walkSpeedValue then
			h.WalkSpeed = walkSpeedValue
		end
	end)
end

local function refreshHumanoid()
	if not humanoid or not humanoid.Parent then
		local h = character and character:FindFirstChildOfClass("Humanoid")
		if h and h ~= humanoid then
			humanoid = h
			bindHumanoid(h)
		end
	end
	return humanoid
end

local function applyWalkSpeed()
	local h = refreshHumanoid()
	if not h then return end
	if speedMode then
		if h.WalkSpeed ~= walkSpeedValue then h.WalkSpeed = walkSpeedValue end
	end
end

local function onCharacterAdded(newCharacter)
	character = newCharacter
	rootPart = newCharacter:WaitForChild("HumanoidRootPart", 10)
	humanoid = newCharacter:WaitForChild("Humanoid", 10)
	bindHumanoid(humanoid)
	if humanoid then
		humanoid.WalkSpeed = speedMode and walkSpeedValue or WALK_DEFAULT
		humanoid.AutoRotate = not flyEnabled
	end
	if refreshToggles then refreshToggles() end
end

player.CharacterAdded:Connect(onCharacterAdded)
if player.Character then task.spawn(onCharacterAdded, player.Character) end

local function setSpeedMode(enabled)
	speedMode = enabled
	local h = refreshHumanoid()
	if not h then
		print("[DevUtilityV2] ยังไม่พบ Humanoid — จะลองใหม่อัตโนมัติ")
		return
	end
	if speedMode then
		h.WalkSpeed = walkSpeedValue
		h.Health = h.MaxHealth
		print("[DevUtilityV2] เปิดวิ่งเร็ว → WalkSpeed = " .. walkSpeedValue)
	else
		h.WalkSpeed = WALK_DEFAULT
		print("[DevUtilityV2] ปิดวิ่งเร็ว → WalkSpeed = " .. WALK_DEFAULT)
	end
end

-- ===================== Fade หน้าจอดำ =====================
local FADE_DURATION = 0.3
local function fadeOverlay(action)
	local gui = Instance.new("ScreenGui")
	gui.Name = "DevUtilityV2FadeGui"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 1000
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.new(0, 0, 0)
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Parent = gui
	gui.Parent = playerGui
	local fadeIn = TweenService:Create(frame, TweenInfo.new(FADE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0 })
	fadeIn:Play()
	fadeIn.Completed:Wait()
	if action then action() end
	local fadeOut = TweenService:Create(frame, TweenInfo.new(FADE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 })
	fadeOut:Play()
	fadeOut.Completed:Wait()
	gui:Destroy()
end

-- ===================== NoClip / บิน =====================
local function setNoClip(enabled)
	noClipEnabled = enabled
	if not noClipEnabled and character then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then part.CanCollide = true end
		end
	end
end

local function setFly(enabled)
	flyEnabled = enabled
	if flyConnection then flyConnection:Disconnect() flyConnection = nil end
	if humanoid then humanoid.AutoRotate = not flyEnabled end
	if flyEnabled and rootPart then
		flyConnection = RunService.RenderStepped:Connect(function(dt)
			if not (flyEnabled and rootPart and rootPart.Parent) then return end
			rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			local cam = workspace.CurrentCamera
			if not cam then return end
			local dir = Vector3.new(0, 0, 0)
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
			if dir.Magnitude > 0 then
				rootPart.CFrame = rootPart.CFrame + dir.Unit * flySpeed * dt
			end
		end)
	end
end

