		envSpecular = Lighting.EnvironmentSpecularScale, envDiffuse = Lighting.EnvironmentDiffuseScale,
		globalShadows = Lighting.GlobalShadows,
		effects = {}, atmospheres = {},
		enabled = {}, trails = {}, materials = {}, reflect = {}, shadows = {}, meshTex = {},
		surfaces = {}, textures = {}, terrain = nil,
	}
	boostBackup = b -- ตั้งก่อน เพื่อให้สถานะ/ปุ่มเปลี่ยนเป็น "เปิด" ทันที
	boostSummaryState = "busy"
	devLog("lgBoostOn")

	pcall(function()
		b.quality = settings().Rendering.QualityLevel
		settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
	end)

	-- Lighting: ปิดเอฟเฟกทุกชนิด + หมอก + เงา + การสะท้อน
	pcall(function()
		for _, child in ipairs(Lighting:GetChildren()) do
			if child:IsA("PostEffect") then
				table.insert(b.effects, { child, child.Enabled }); child.Enabled = false
			elseif child:IsA("Atmosphere") then
				table.insert(b.atmospheres, { child, child.Density, child.Offset })
				child.Density = 0; child.Offset = 0
			end
		end
		Lighting.FogStart = 0
		Lighting.FogEnd = 100000000
		Lighting.EnvironmentSpecularScale = 0
		Lighting.EnvironmentDiffuseScale = 0
		Lighting.GlobalShadows = false
	end)

	-- ของใหม่ที่โหลดเข้ามาทีหลัง (เช่น StreamingEnabled) ก็แปลงด้วย
	boostAddedConn = workspace.DescendantAdded:Connect(function(inst)
		if boostBackup == b then boostInstance(inst, b) end
	end)

	-- วนแปลงทั้ง Workspace เป็นชุด ๆ ไม่ให้เกมค้าง
	task.spawn(function()
		local count = 0
		for _, inst in ipairs(workspace:GetDescendants()) do
			if boostBackup ~= b then return end -- ถูกปิดระหว่างทำ → หยุด
			boostInstance(inst, b)
			count = count + 1
			if count % 400 == 0 then task.wait() end
		end
		if boostBackup == b then
			lastBoostStats = { #b.materials, #b.textures + #b.meshTex, #b.surfaces, #b.enabled, #b.effects, #b.shadows }
			boostSummaryState = "done"
			renderBoostSummary()
		end
	end)

	return T("boostBusy")
end

local function restoreBoostFPS()
	if not boostBackup then return T("boostNotOn") end
	boostSummaryState = "restoring"
	local b = boostBackup
	boostBackup = nil -- ตั้งก่อน เพื่อหยุดลูปแปลงที่ค้างอยู่
	if boostAddedConn then boostAddedConn:Disconnect() boostAddedConn = nil end

	pcall(function() if b.quality then settings().Rendering.QualityLevel = b.quality end end)
	pcall(function()
		for _, it in ipairs(b.effects) do if it[1].Parent then it[1].Enabled = it[2] end end
		for _, it in ipairs(b.atmospheres) do
			if it[1].Parent then it[1].Density = it[2]; it[1].Offset = it[3] end
		end
		Lighting.FogStart = b.fogStart
		Lighting.FogEnd = b.fogEnd
		Lighting.EnvironmentSpecularScale = b.envSpecular
		Lighting.EnvironmentDiffuseScale = b.envDiffuse
		Lighting.GlobalShadows = b.globalShadows
	end)

	local function each(list, fn)
		for i, it in ipairs(list) do
			pcall(fn, it)
			if i % 400 == 0 then task.wait() end
		end
	end
	task.spawn(function()
		each(b.enabled, function(it) if it[1].Parent then it[1].Enabled = it[2] end end)
		each(b.trails, function(it) if it[1].Parent then it[1].Transparency = it[2] end end)
		each(b.materials, function(it) if it[1].Parent then it[1].Material = it[2] end end)
		each(b.reflect, function(it) if it[1].Parent then it[1].Reflectance = it[2] end end)
		each(b.shadows, function(it) if it[1].Parent then it[1].CastShadow = true end end)
		each(b.meshTex, function(it) if it[1].Parent then it[1].TextureID = it[2] end end)
		each(b.surfaces, function(it) if it[2] and it[2].Parent then it[1].Parent = it[2] end end)
		each(b.textures, function(it) if it[1].Parent then it[1].Texture = it[2] end end)
		if b.terrain then
			pcall(function()
				local t = workspace.Terrain
				t.Decoration, t.WaterWaveSize, t.WaterWaveSpeed, t.WaterReflectance = b.terrain[1], b.terrain[2], b.terrain[3], b.terrain[4]
			end)
		end
		boostSummaryState = "restored"
		lastBoostStats = nil
		renderBoostSummary()
		devLog("lgBoostRestore")
	end)
	return T("boostRestoreBusy")
end

-- ===================== ระบบต่อสู้: ทีม / ESP / Aimbot / รีโหลดไว =====================
-- ⚠️ ใช้ทดสอบเกมของตัวเองเท่านั้น ห้ามนำไปใช้ในเกมคนอื่น
-- กติกาทีม: มีทีมและตรงกัน = เพื่อนร่วมทีม (ไม่เล็ง/ไม่ขึ้น ESP) | ไม่มีทีมทั้งคู่ = ถือเป็นศัตรู
local function isTeammate(other)
	if not other or other == player then return false end
	if player.Team and other.Team and player.Team == other.Team then return true end
	return false
end

-- ---------- ESP: Highlight ทะลุกำแพง + ป้ายชื่อ/ระยะ (เฉพาะศัตรู) ----------
local function removeEspFrom(model)
	local data = espApplied[model]
	if not data then return end
	espApplied[model] = nil
	pcall(function()
		if data.highlight then data.highlight:Destroy() end
		if data.billboard then data.billboard:Destroy() end
	end)
end

local function addEspTo(charModel)
	if espApplied[charModel] then return end
	local head = charModel:FindFirstChild("Head") or charModel:FindFirstChildWhichIsA("BasePart")
	if not head then return end
	local hl = Instance.new("Highlight")
	hl.Name = "DevESP_Highlight" -- Boost FPS จะไม่แตะ Highlight ชื่อนี้
	hl.FillColor = Color3.fromRGB(255, 45, 45)
	hl.OutlineColor = Color3.fromRGB(255, 165, 0)
	hl.FillTransparency = 0.65
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- เห็นทะลุกำแพง
	hl.Parent = charModel
	local bb = Instance.new("BillboardGui")
	bb.Name = "DevESP_Billboard"
	bb.Size = UDim2.new(0, 150, 0, 20)
	bb.StudsOffset = Vector3.new(0, 2.4, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 2000
	bb.Parent = head
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 0.4
	label.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	label.TextColor3 = Color3.fromRGB(255, 240, 130)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 12
	label.Text = charModel.Name
	label.Parent = bb
	espApplied[charModel] = { highlight = hl, billboard = bb, label = label }
end

-- ทวน ESP 4 ครั้ง/วินาที: เพิ่มศัตรูใหม่ / ลบคนตาย คนออก คนกลายเป็นเพื่อน
local function refreshESP()
	local enemies = {}
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and not isTeammate(other) then
			local charModel = other.Character
			if charModel and charModel.Parent then
				local hum = charModel:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 then enemies[charModel] = true end
			end
		end
	end
	for model in pairs(espApplied) do
		if not enemies[model] then removeEspFrom(model) end
	end
	for model in pairs(enemies) do
		addEspTo(model)
		local data = espApplied[model]
		local part = model:FindFirstChild("HumanoidRootPart")
		if data and part and rootPart then
			local dist = math.floor((part.Position - rootPart.Position).Magnitude + 0.5)
			data.label.Text = "[" .. dist .. "m] " .. model.Name
		end
	end
end

local function setESP(enabled)
	espEnabled = enabled
	if not espEnabled then
		for model in pairs(espApplied) do removeEspFrom(model) end
		devLog("lgEspOff")
	else
		refreshESP()
		devLog("lgEspOn")
	end
end

-- ---------- Aimbot: "ยิงในวง = โดน" (หักกล้องต่อเนื่องระหว่างกดยิง) ----------
-- ไม่ล็อกกล้องถาวร: ทำงานเฉพาะตอนกด LMB ยิง และเป้าต้องอยู่ในวง FOV เท่านั้น
-- วิธีทำ: หักกล้องไปหาเป้าทุกเฟรม + ชดเดาตำแหน่งเป้าที่กำลังวิ่ง → ปืนที่ยิงตามกล้องจะโดน
-- ข้อจำกัดจริง: LocalScript ขยับกระสุนที่เซิร์ฟเวอร์สร้างไม่ได้ จึงโกงทิศทางกระสุนตรง ๆ ไม่ได้
local function getAimPart(charModel)
	if aimPartMode == 1 then
		return charModel:FindFirstChild("Head")
	elseif aimPartMode == 2 then
		return charModel:FindFirstChild("HumanoidRootPart")
	end
	return charModel:FindFirstChild("UpperTorso") or charModel:FindFirstChild("Torso") or charModel:FindFirstChild("HumanoidRootPart")
end

-- รวมรายชื่อเป้า (ศัตรู + NPC ที่ยังมีชีวิต) ทุก 0.25 วิ
local function refreshAimCandidates()
	local list = {}
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and not isTeammate(other) then
			local charModel = other.Character
			if charModel then
				local hum = charModel:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 and charModel:FindFirstChild("HumanoidRootPart") then
					list[#list + 1] = { model = charModel }
				end
			end
		end
	end
	-- NPC: Model ที่มี Humanoid ยังมีชีวิต และไม่ใช่ตัวละครของผู้เล่นคนไหน (รวมตัวเราด้วย)
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst:IsA("Model") and inst ~= character and not Players:GetPlayerFromCharacter(inst) then
			local hum = inst:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 and inst:FindFirstChild("HumanoidRootPart") then
				list[#list + 1] = { model = inst }
			end
		end
	end
	aimCandidates = list
end

-- เลือกเป้าที่มุมแคบสุดจากกล้อง (ต้องอยู่ในวง FOV, ไม่เกินระยะ, ไม่มีกำแพงบัง)
local function findBestTarget()
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local camPos = cam.CFrame.Position
	local halfFov = math.rad(aimFov) / 2 -- รัศมีของวง = ครึ่งเส้นผ่านศูนย์กลาง
	local bestModel, bestPart, bestAngle = nil, nil, halfFov
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	for _, cand in ipairs(aimCandidates) do
		local charModel = cand.model
		if charModel and charModel.Parent then
			local part = getAimPart(charModel) or charModel:FindFirstChild("HumanoidRootPart")
			if part then
				local toTarget = part.Position - camPos
				local dist = toTarget.Magnitude
				if dist > 1 and dist <= aimRange then
					local angle = math.acos(math.clamp(cam.CFrame.LookVector:Dot(toTarget / dist), -1, 1))
					if angle <= bestAngle then
						-- เช็กการมองเห็น: ยิงรังสีจากกล้อง → ถ้าชนอย่างอื่นก่อนถึงตัว = ถูกบัง ข้ามเป้านี้
						local hit = workspace:Raycast(camPos, toTarget, params)
						local visible = true
						if hit then
							visible = hit.Instance:IsDescendantOf(charModel)
						end
						if visible then
							bestModel, bestPart, bestAngle = charModel, part, angle
						end
					end
				end
			end
		end
	end
	return bestModel, bestPart
end

-- จุดเล็ง = ตำแหน่งเป้า + ความเร็วของเป้า × เวลากระสุนโดยประมาณ (ชดเดาให้โดนตอนเป้ากำลังวิ่ง)
local function predictedAimPosition(part, charModel)
	local pos = part.Position
	local root = charModel:FindFirstChild("HumanoidRootPart")
	if root and rootPart then
		local dist = (pos - workspace.CurrentCamera.CFrame.Position).Magnitude
		local leadTime = math.clamp(dist / 900, 0, 0.35)
		pos = pos + root.AssemblyLinearVelocity * leadTime
	end
	return pos
end

-- หักกล้องไปหาเป้าแบบนุ่ม — เรียกทุกเฟรมผ่าน BindToRenderStep (หลังกล้องเกม)
local function aimCameraStep()
	if not (aimbotEnabled and fireAiming) then return end
	local cam = workspace.CurrentCamera
	if not cam then return end
	local charModel, part = findBestTarget()
	if not charModel or not part then return end
	local aimPos = predictedAimPosition(part, charModel)
	local toAim = aimPos - cam.CFrame.Position
	if toAim.Magnitude < 0.5 then return end
	local alpha = math.clamp(aimSmooth / 100, 0.05, 1) -- 100 = หักทันที, ต่ำกว่า = นุ่มกว่า
	local newLook = cam.CFrame.LookVector:Lerp(toAim.Unit, alpha)
	cam.CFrame = CFrame.new(cam.CFrame.Position, cam.CFrame.Position + newLook)
end

-- วงกลม FOV กลางจอ (วาดด้วย Frame กลม ไม่พึ่ง Drawing API)
local function updateFovCircle()
	if not fovCircle then return end
	fovCircle.Visible = fovCircleEnabled
	if not fovCircleEnabled then return end
	local cam = workspace.CurrentCamera
	if not cam then return end
	-- แปลงองศาของวงเป็นพิกเซล โดยเทียบกับมุมมองกล้องปัจจุบัน
	local ratio = math.tan(math.rad(aimFov) / 2) / math.tan(math.rad(cam.FieldOfView) / 2)
	local diameter = math.clamp(2 * ratio * (cam.ViewportSize.Y / 2), 8, 3000)
	fovCircle.Size = UDim2.fromOffset(diameter, diameter)
end

-- เช็กว่าจุดที่คลิกอยู่ในหน้าต่างเมนูไหม (กัน Aimbot ทำงานตอนคลิกปุ่มเมนู)
local function isPointerInsideMenu(input)
	if not mainWindow or not mainWindow.Visible then return false end
	local p = input.Position
	local absPos, absSize = mainWindow.AbsolutePosition, mainWindow.AbsoluteSize
	return p.X >= absPos.X and p.X <= absPos.X + absSize.X and p.Y >= absPos.Y and p.Y <= absPos.Y + absSize.Y
end

-- ดักปุ่มยิง: กดซ้ายค้าง = เริ่มหักกล้อง | ปล่อย = หยุดทันที (คลิกในเมนูจะไม่ทำงาน)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 and not isPointerInsideMenu(input) then
		fireAiming = true
	end
end)
UserInputService.InputEnded:Connect(function(input)
	-- ปล่อยเมาส์หรือยกนิ้ว (ทัช) = หยุดยิงทันที
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		fireAiming = false
		if ui.fireButton and ui.fireButton.Visible then
			ui.fireButton.BackgroundColor3 = COLOR_ACCENT
		end
	end
end)

local function setAimbot(enabled)
	aimbotEnabled = enabled
	fireAiming = false
	if ui.fireButton then ui.fireButton.Visible = aimbotEnabled end -- ปุ่ม 🔥 (ใช้ได้ทั้งเมาส์และทัช)
	if aimbotEnabled then
		refreshAimCandidates()
		devLog("lgAimbotOn")
	else
		devLog("lgAimbotOff")
	end
end

local function cycleAimPart()
	aimPartMode = (aimPartMode % #AIM_PARTS.th) + 1
	devLog("lgAimPart", aimPartName())
	if refreshToggles then refreshToggles() end
end

local function setFovCircle(enabled)
	fovCircleEnabled = enabled
	updateFovCircle()
end

-- ---------- รีโหลดไว (ทำงานกับปืนที่เก็บเวลาโหลดใน Value/Attribute ของ Tool) ----------
-- ข้อจำกัดของ Roblox: LocalScript แตะตัวแปรใน LocalScript ของปืนไม่ได้ → ถ้าเกมเก็บเวลาโหลดในโค้ด โหมดนี้จะไม่มีผล
local FAST_RELOAD_TIME = 0.05 -- วินาทีที่เร่งไป
local reloadHitNames = {}     -- ชื่อค่าที่เจอบนปืน (ใช้รายงานครั้งแรก)
local reloadReported = {}     -- กันรายงานซ้ำ { hit, noHit, noTool } (รีเซ็ตทุกครั้งที่เปิดใช้)

local function isReloadTimeName(name)
	-- จับชื่อที่มี reload เช่น ReloadTime, reloadDelay / refill เช่น RefillTime
	local lower = string.lower(name)
	return string.find(lower, "reload", 1, true) ~= nil or string.find(lower, "refill", 1, true) ~= nil
end

local function scanToolsForReload()
	if not fastReloadEnabled or not character then return end
	local tools = {}
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Tool") then tools[#tools + 1] = child end
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		for _, child in ipairs(backpack:GetChildren()) do
			if child:IsA("Tool") then tools[#tools + 1] = child end
		end
	end
	table.clear(reloadHitNames)
	if #tools == 0 then
		if not reloadReported.noTool then
			reloadReported.noTool = true
			devLog("lgReloadNoTool")
		end
		return
	end

	local function considerValue(valueObj)
		-- Value ที่เก็บเวลาโหลด (เช่น NumberValue "ReloadTime")
		if (valueObj:IsA("NumberValue") or valueObj:IsA("IntValue")) and isReloadTimeName(valueObj.Name) then
			if not reloadTracked[valueObj] then
				reloadTracked[valueObj] = true
				table.insert(reloadBackup, { inst = valueObj, attr = nil, value = valueObj.Value })
			end
			if valueObj.Value > FAST_RELOAD_TIME then valueObj.Value = FAST_RELOAD_TIME end
			reloadHitNames[valueObj.Name] = true
		end
	end
	local function considerAttrs(inst)
		-- Attribute ตัวเลขชื่อเกี่ยวกับ reload — สแกนทุกชั้น (ของเดิมสแกนเฉพาะบนตัว Tool)
		for attrName, attrValue in pairs(inst:GetAttributes()) do
			if typeof(attrValue) == "number" and isReloadTimeName(attrName) then
				local key = tostring(inst) .. "|" .. attrName
				if not reloadTracked[key] then
					reloadTracked[key] = true
					table.insert(reloadBackup, { inst = inst, attr = attrName, value = attrValue })
				end
				if attrValue > FAST_RELOAD_TIME then inst:SetAttribute(attrName, FAST_RELOAD_TIME) end
				reloadHitNames[attrName] = true
			end
		end
	end
	for _, tool in ipairs(tools) do
		considerAttrs(tool) -- ตัว Tool เอง
		for _, desc in ipairs(tool:GetDescendants()) do
			considerValue(desc)
			considerAttrs(desc)
		end
	end

	-- รายงานผลครั้งแรกของการเปิดใช้ (บอกชัดว่าเจอค่าไหน หรือไม่เจอเพราะอะไร)
	local names = {}
	for n in pairs(reloadHitNames) do names[#names + 1] = n end
	if #names > 0 then
		if not reloadReported.hit then
			reloadReported.hit = true
			table.sort(names)
			devLog("lgReloadHit", table.concat(names, ", "), tostring(FAST_RELOAD_TIME))
		end
	elseif not reloadReported.noHit then
		reloadReported.noHit = true
		devLog("lgReloadNoHit")
	end
end

local function setFastReload(enabled)
	fastReloadEnabled = enabled
	if fastReloadEnabled then
		reloadReported = {} -- รายงานผลใหม่ทุกครั้งที่เปิดใช้
		scanToolsForReload()
		devLog("lgReloadOn")
	else
		for _, item in ipairs(reloadBackup) do
			pcall(function()
				if item.inst.Parent then
					if item.attr then item.inst:SetAttribute(item.attr, item.value)
					else item.inst.Value = item.value end
				end
			end)
		end
		reloadBackup = {}
		reloadTracked = {}
		reloadReported = {}
		devLog("lgReloadOff")
	end
end

-- ===================== โหมดหายตัว (ซ่อนจากทุกคน — ต้องมีสคริปต์เซิร์ฟ) =====================
-- LocalScript คนเดียวทำให้ "คนอื่น" ไม่เห็นไม่ได้ (ความโปร่งแสงต้องเซิร์ฟเป็นคนตั้ง)
-- วิธีใช้: กดปุ่มครั้งแรก → จะพิมพ์ซอร์สสคริปต์ลง Output (และเก็บใน StringValue ที่ ReplicatedStorage)
--          คัดลอกไปวางเป็น Script ใน ServerScriptService หนึ่งครั้ง แล้วกดปุ่มใหม่ → ใช้ได้จริงทุกคนในแมพ
local INVIS_SERVER_SOURCE = [==[
-- ===== DevInvisibilityServer: ฝั่งเซิร์ฟของ "โหมดหายตัว" (เกมของตัวเอง) =====
-- วางเป็น Script ใน ServerScriptService หนึ่งครั้ง แล้วกด Play
-- ได้ยิน RemoteEvent "DevInvsRemote" ใน ReplicatedStorage: true = ซ่อน, false = คืนสภาพ
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local remote = ReplicatedStorage:FindFirstChild("DevInvsRemote")
if not remote then
	remote = Instance.new("RemoteEvent")
	remote.Name = "DevInvsRemote"
	remote.Parent = ReplicatedStorage
end

-- sessions[player] = { hidden, backup = { [instance] = ค่าเดิม }, disp = { name, health } }
local sessions = {}

local function applyHide(player, on)
	local session = sessions[player]
	if not session then return end
	local character = player.Character
	if not character then return end
	for _, inst in ipairs(character:GetDescendants()) do
		if inst:IsA("BasePart") or inst:IsA("Decal") or inst:IsA("Texture") then
			-- BasePart / หน้า / เท็กซ์เจอร์บนตัว: จำค่าเดิมรอบแรกที่เจอ แล้วซ่อน/คืน
			local saved = session.backup[inst]
			if not saved then
				saved = inst.Transparency
				session.backup[inst] = saved
			end
			if on then
				inst.Transparency = 1
			else
				inst.Transparency = saved
			end
		elseif inst:IsA("BillboardGui") or inst:IsA("SurfaceGui") then
			-- ป้ายชื่อ/เลือด/Gui ที่ติดตัว (ทั้งของระบบและของเกม): ปิดตอนซ่อน
			local saved = session.backup[inst]
			if not saved then
				saved = inst.Enabled
				session.backup[inst] = saved
			end
			if on then
				inst.Enabled = false
			else
				inst.Enabled = saved
			end
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		if not session.disp then
			session.disp = { name = humanoid.NameDisplayDistance, health = humanoid.HealthDisplayDistance }
		end
		humanoid.NameDisplayDistance = on and 0 or session.disp.name
		humanoid.HealthDisplayDistance = on and 0 or session.disp.health
	end
end

local function watchCharacter(player)
	player.CharacterAdded:Connect(function(character)
		local session = sessions[player]
		if session and session.hidden then
			-- เกิดใหม่ระหว่างที่ยังเปิดอยู่ → เคลียร์ของเก่า (instance เดิมถูกทำลายแล้ว) แล้วซ่อนใหม่
			session.backup = {}
			session.disp = nil
			character:WaitForChild("Humanoid", 10)
			task.wait(0.1) -- รอให้ parts โหลดครบก่อนซ่อน
			applyHide(player, true)
		end
	end)
end

remote.OnServerEvent:Connect(function(player, wantHide)
	if type(wantHide) ~= "boolean" then return end
	local session = sessions[player]
	if not session then
		session = { hidden = false, backup = {}, disp = nil }
		sessions[player] = session
		watchCharacter(player)
	end
	session.hidden = wantHide
	if wantHide then
		session.backup = {}
		session.disp = nil
		applyHide(player, true) -- เก็บค่าเดิมก่อนซ่อน
	else
		applyHide(player, false) -- คืนค่าจาก backup ก่อน (ห้ามเคลียร์ก่อน ไม่งั้นคืนไม่ได้)
		session.backup = {}
		session.disp = nil
	end
	print("[DevInvisibilityServer] " .. player.Name .. " → ซ่อนตัว: " .. tostring(wantHide))
end)

Players.PlayerRemoving:Connect(function(player)
	sessions[player] = nil
end)

-- วนเช็กทุก 0.5 วิ ระหว่างซ่อน: กันสคริปต์อื่น/การเกิดใหม่ทำให้ตัวโผล่กลางทาง
task.spawn(function()
	while true do
		task.wait(0.5)
		for player, session in pairs(sessions) do
			if session.hidden and player.Parent then
				applyHide(player, true)
			end
		end
	end
end)

