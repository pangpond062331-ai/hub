-- การลากหน้าต่าง: คลิกค้างที่แถบหัวเรื่องแล้วเลื่อนเมาส์
local dragging = false                                         -- สถานะว่ากำลังลากอยู่หรือไม่
local dragStart = nil                                          -- ตำแหน่งเมาส์ตอนเริ่มลาก
local dragStartPos = nil                                       -- ตำแหน่งหน้าต่างตอนเริ่มลาก
titleBar.InputBegan:Connect(function(input)                    -- เริ่มรับ input บนแถบหัวเรื่อง
	if input.UserInputType == Enum.UserInputType.MouseButton1 then -- ถ้าเป็นคลิกซ้าย
		dragging = true                                         -- เริ่มสถานะลาก
		dragStart = input.Position                              -- จำตำแหน่งเมาส์ตอนคลิก
		dragStartPos = mainWindow.Position                      -- จำตำแหน่งหน้าต่างตอนคลิก
	end
end)
titleBar.InputEnded:Connect(function(input)                    -- ปล่อย input บนแถบหัวเรื่อง
	if input.UserInputType == Enum.UserInputType.MouseButton1 then -- ถ้าเป็นการปล่อยคลิกซ้าย
		dragging = false                                        -- หยุดสถานะลาก
	end
end)
UserInputService.InputChanged:Connect(function(input)          -- ทุกครั้งที่ input เปลี่ยน (เช่น เมาส์ขยับ)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then -- ถ้ากำลังลากและเมาส์ขยับ
		local delta = input.Position - dragStart                -- คำนวณระยะที่เมาส์ขยับจากระยะเริ่มลาก
		mainWindow.Position = UDim2.new(                        -- ตั้งตำแหน่งใหม่ของหน้าต่าง
			dragStartPos.X.Scale, dragStartPos.X.Offset + delta.X, -- ส่วนแกน X = ตำแหน่งเดิม + ระยะที่ขยับ
			dragStartPos.Y.Scale, dragStartPos.Y.Offset + delta.Y  -- ส่วนแกน Y = ตำแหน่งเดิม + ระยะที่ขยับ
		)
	end
end)

-- ===================== ฟังก์ชันอัปเดตป้าย UI ทุกจุด (เรียกเมื่อสถานะเปลี่ยน) =====================
refreshToggles = function()
	for _, item in ipairs(toggleRegistry) do                    -- วนปุ่ม toggle ทุกปุ่ม
		local on = item.getState()                              -- อ่านสถานะปัจจุบันของระบบปุ่มนี้
		item.button.Text = item.name .. (on and "  [เปิด]" or "  [ปิด]") -- ต่อข้อความบอกสถานะบนปุ่ม
		item.button.BackgroundColor3 = on and COLOR_ACCENT or COLOR_BTN   -- เปิด = สีเน้น / ปิด = สีปกติ
		item.button.TextColor3 = on and COLOR_DARK or COLOR_TEXT         -- เปิด = ตัวอักษรมืด / ปิด = ตัวอักษรสว่าง
	end
	if ui.walkSpeedLabel then ui.walkSpeedLabel.Text = "🏃 ความเร็ววิ่ง: " .. walkSpeedValue end    -- อัปเดตป้ายความเร็ววิ่ง
	if ui.flySpeedLabel then ui.flySpeedLabel.Text = "🚀 ความเร็วบิน: " .. flySpeed end            -- อัปเดตป้ายความเร็วบิน
	if ui.aimPartButton then ui.aimPartButton.Text = "🎯 จุดเล็ง: " .. AIM_PARTS[aimPartIndex].label end -- อัปเดตป้ายจุดเล็ง Aimbot
	if ui.point1Label then ui.point1Label.Text = "Point 1: " .. (point1 and formatVector3(point1.Position) or "(ยังไม่ได้บันทึก)") end -- อัปเดตป้าย Point 1
	if ui.point2Label then ui.point2Label.Text = "Point 2: " .. (point2 and formatVector3(point2.Position) or "(ยังไม่ได้บันทึก)") end -- อัปเดตป้าย Point 2
	if ui.waypointCountLabel then ui.waypointCountLabel.Text = "ที่บันทึก: " .. #waypoints .. " จุด" end -- อัปเดตจำนวน Waypoint
	if ui.statusLabel then ui.statusLabel.Text = statusString() end                              -- อัปเดตป้ายสถานะรวม
end

