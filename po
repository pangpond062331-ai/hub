-- ===================== ฟังก์ชันช่วยเหลือ (Helpers) =====================

-- ปัดเศษตัวเลขให้เหลือทศนิยม 2 ตำแหน่ง เพื่อให้ค่าที่พิมพ์/แสดงอ่านง่าย
local function round2(n)
	return math.round(n * 100) / 100                            -- คูณ 100 → ปัดเศษ → หาร 100 คืนเป็นทศนิยม 2 ตำแหน่ง
end

-- แปลง Vector3 เป็นข้อความรูปแบบ Vector3.new(X, Y, Z) เพื่อแสดงผล/พิมพ์ลง Output ให้ก๊อปปี้เป็นโค้ดได้
local function formatVector3(v)
	return "Vector3.new("                                        -- เริ่มด้วยข้อความ Vector3.new(
		.. tostring(round2(v.X)) .. ", "                         -- ตามด้วยค่า X ปัดเศษแล้ว
		.. tostring(round2(v.Y)) .. ", "                         -- ตามด้วยค่า Y ปัดเศษแล้ว
		.. tostring(round2(v.Z)) .. ")"                          -- ตามด้วยค่า Z ปัดเศษแล้ว + ปิดวงเล็บ
end

-- แปลงจำนวนวินาทีเป็นข้อความ HH:MM:SS สำหรับแสดงเวลาที่เปิดใช้งาน
local function formatDuration(totalSeconds)
	local hours = math.floor(totalSeconds / 3600)               -- หาร 3600 เอาส่วนชั่วโมง
	local minutes = math.floor((totalSeconds % 3600) / 60)       -- เอาเศษส่วนที่เหลือไปหาร 60 เพื่อหาส่วนนาที
	local seconds = math.floor(totalSeconds % 60)                -- เอาเศษวินาทีที่เหลือ
	return string.format("%02d:%02d:%02d", hours, minutes, seconds) -- คืนข้อความรูปแบบ 00:00:00
end

-- ยิง Ray จากกล้องผ่านตำแหน่งเมาส์ เพื่อหา "จุดที่เมาส์ชี้" บนวัตถุในโลก (คืน nil ถ้าไม่โดนอะไร)
local function getMouseHit()
	local cam = workspace.CurrentCamera                          -- ดึงกล้องปัจจุบันใหม่ทุกครั้ง
	if not cam then return nil end                              -- ยังไม่มีกล้อง → คืน nil
	local mouseLocation = UserInputService:GetMouseLocation()   -- อ่านตำแหน่งเมาส์บนหน้าจอ (หน่วย Pixel)
	local ray = cam:ViewportPointToRay(mouseLocation.X, mouseLocation.Y) -- แปลงตำแหน่งหน้าจอเป็น Ray จากกล้อง
	local params = RaycastParams.new()                          -- สร้างตั้งค่าการยิง Ray
	params.FilterType = Enum.RaycastFilterType.Exclude          -- ใช้โหมด "ยกเว้น" Instance ที่ระบุ
	params.FilterDescendantsInstances = { character }           -- ยกเว้นตัวละครตัวเอง กันชี้โดนตัวเรา
	return workspace:Raycast(ray.Origin, ray.Direction * 5000, params) -- ยิง Ray ไกล 5,000 สตั๊ด แล้วคืนผลที่เจอ
end

-- สร้างข้อความสรุปสถานะโหมดต่าง ๆ สำหรับแสดงบน HUD (ใช้ทั้งใน GUI และอัปเดตอัตโนมัติ)
