-- ===================== จัดการตัวละคร (รันใหม่ทุกครั้งที่ตัวละครเกิด) =====================
local function onCharacterAdded(newCharacter)
	character = newCharacter                                      -- เก็บ Model ตัวละครตัวใหม่
	rootPart = newCharacter:WaitForChild("HumanoidRootPart", 10)  -- รอ Part หลักของตัวละคร (สูงสุด 10 วิ)
	humanoid = newCharacter:WaitForChild("Humanoid", 10)          -- รอ Humanoid (สูงสุด 10 วิ)
	if humanoid then                                             -- ถ้าหา Humanoid เจอ
		humanoid.WalkSpeed = WALK_DEFAULT                         -- คืนค่าความเร็ววิ่งเป็นค่าปกติของ Roblox
		humanoid.AutoRotate = not flyEnabled                      -- ถ้ากำลังบินอยู่ให้ปิดการหมั่นหน้าอัตโนมัติ
	end
	speedMode = false                                            -- รีเซ็ตสถานะวิ่งเร็วไม่ให้ค้างข้ามการเกิดใหม่
	-- * NoClip/บิน ไม่รีเซ็ต เพราะเป็นสวิตช์ที่ผู้ใช้เปิดไว้ ตัวละครใหม่จะยังคงโหมดเดิม
	if refreshToggles then refreshToggles() end                  -- อัปเดตป้าย UI ให้ตรงกับสถานะใหม่
end

player.CharacterAdded:Connect(onCharacterAdded)                 -- ผูกฟังก์ชันกับอีเวนต์ "ตัวละครเกิดใหม่"
if player.Character then                                        -- ถ้าตัวละครมีอยู่แล้ว (สคริปต์รันช้ากว่า)
	onCharacterAdded(player.Character)                           -- เรียกใช้ทันทีเพื่ออ้างอิงตัวละครเดิม
end

-- ===================== เอฟเฟกต์ Fade หน้าจอดำ (ใช้ตอนวาร์ปประตู) =====================
local FADE_DURATION = 0.3                                        -- ระยะเวลา Fade 1 รอบ (วินาที)

-- ทำเอฟเฟกต์จอดำ → รันงานที่ส่งมา (action) → จอกลับใส → ลบ GUI ทิ้ง
local function fadeOverlay(action)
	local gui = Instance.new("ScreenGui")                        -- สร้าง GUI ชั่วคราวสำหรับจอดำ
	gui.Name = "DevUtilityV2FadeGui"                             -- ตั้งชื่อ GUI
	gui.IgnoreGuiInset = true                                    -- ครอบคลุมถึงแถบ UI ด้านบน
	gui.ResetOnSpawn = false                                     -- ไม่ให้หายตอนตัวละครเกิดใหม่
	gui.DisplayOrder = 1000                                      -- ให้แสดงทับ GUI อื่นทั้งหมด
	local frame = Instance.new("Frame")                          -- กรอบสีดำเต็มจอ
	frame.Size = UDim2.fromScale(1, 1)                           -- ครอบคลุมทั้งจอ
	frame.BackgroundColor3 = Color3.new(0, 0, 0)                 -- สีดำสนิท
	frame.BackgroundTransparency = 1                             -- เริ่มโปร่งใส 100% (ยังมองไม่เห็น)
	frame.BorderSizePixel = 0                                    -- ปิดเส้นขอบ
	frame.Parent = gui                                           -- ใส่ Frame เข้า GUI
	gui.Parent = playerGui                                       -- ใส่ GUI เข้า PlayerGui ของเรา
	local fadeIn = TweenService:Create(                          -- สร้าง Tween สำหรับ Fade เข้า
		frame,
		TweenInfo.new(FADE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ BackgroundTransparency = 0 }                           -- ค่าปลายทาง = ทึบสนิท (ดำ)
	)
	fadeIn:Play()                                                -- เริ่ม Fade เข้า
	fadeIn.Completed:Wait()                                      -- รอจนจอดำสนิท
	if action then                                               -- ถ้ามีงานต้องทำระหว่างจอดำ (การวาร์ป)
		action()                                                 -- รันงานนั้น เช่น ย้ายตัวละคร
	end
	local fadeOut = TweenService:Create(                         -- สร้าง Tween สำหรับ Fade ออก
		frame,
		TweenInfo.new(FADE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ BackgroundTransparency = 1 }                           -- ค่าปลายทาง = โปร่งใส 100%
	)
	fadeOut:Play()                                               -- เริ่ม Fade ออก
	fadeOut.Completed:Wait()                                     -- รอจนจอใสสนิท
	gui:Destroy()                                                -- ลบ GUI ชั่วคราวทิ้ง
end

-- ===================== ฟังก์ชันระบบตัวละคร =====================

-- โหมดวิ่งเร็ว: เปิด = ตั้ง WalkSpeed เป็นค่าที่ผู้ใช้เลือก + รีเลือดเต็ม / ปิด = คืนค่าปกติ 16
local function setSpeedMode(enabled)
	speedMode = enabled                                          -- อัปเดตสถานะโหมดวิ่งเร็ว
	if not humanoid then return end                             -- ยังไม่มี Humanoid → จบ
	if speedMode then                                            -- ถ้าเปิดโหมดวิ่งเร็ว
		humanoid.WalkSpeed = walkSpeedValue                      -- ตั้งความเร็ววิ่งตามค่าที่เลือกในเมนู
		humanoid.Health = humanoid.MaxHealth                     -- รีเลือดกลับมาเต็มหลอด
	else                                                         -- ถ้าปิดโหมดวิ่งเร็ว
		humanoid.WalkSpeed = WALK_DEFAULT                        -- คืนค่าความเร็วเป็นค่าปกติ 16
	end
end

-- โหมด NoClip: เปิด = ปิดการชนของตัวละครทุกเฟรม / ปิด = คืนค่าการชน
local function setNoClip(enabled)
	noClipEnabled = enabled                                      -- อัปเดตสถานะ NoClip
	if not noClipEnabled and character then                      -- เพิ่งปิด NoClip และมีตัวละคร
		for _, part in ipairs(character:GetDescendants()) do      -- วนทุก Instance ในตัวละคร
			if part:IsA("BasePart") then                          -- เฉพาะ Part ที่มีรูปร่าง
				part.CanCollide = true                           -- คืนค่าให้ชนของแข็งได้ตามปกติ
			end
		end
	end
end

-- โหมดบิน: ขยับตัวละครตามกล้องด้วย WASD + Space ขึ้น / Ctrl ลง โดยยกเลิกแรงโน้มถ่วงทุกเฟรม
local function setFly(enabled)
	flyEnabled = enabled                                         -- อัปเดตสถานะโหมดบิน
	if flyConnection then                                        -- ถ้ามีลูปบินค้างอยู่ (จากครั้งก่อน)
		flyConnection:Disconnect()                               -- ตัดลูปบินเดิมทิ้ง
		flyConnection = nil                                      -- เคลียร์ค่า connection
	end
	if humanoid then                                             -- ถ้ามี Humanoid
		humanoid.AutoRotate = not flyEnabled                     -- ปิดการหมั่นหน้าอัตโนมัติระหว่างบิน
	end
	if flyEnabled and rootPart then                              -- ถ้าเพิ่งเปิดบินและมีตัวละคร
		flyConnection = RunService.RenderStepped:Connect(function(deltaTime)
			if not (flyEnabled and rootPart and rootPart.Parent) then return end -- เช็คว่ายังบินอยู่และตัวภาพยังอยู่
			rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0) -- หักล้างแรงทุกอย่าง (รวมแรงโน้มถ่วง) ให้ลอยค้างก่อน
			local cam = workspace.CurrentCamera                   -- ดึงกล้องปัจจุบัน
			if not cam then return end                           -- ไม่มีกล้อง → จบเฟรมนี้
			local moveDirection = Vector3.new(0, 0, 0)           -- ทิศทางที่จะบิน (เริ่มเป็นศูนย์)
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + cam.CFrame.LookVector end -- บินไปข้างหน้าตามกล้อง
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - cam.CFrame.LookVector end -- บินถอยหลังตามกล้อง
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + cam.CFrame.RightVector end -- บินไปขวาตามกล้อง
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - cam.CFrame.RightVector end -- บินไปซ้ายตามกล้อง
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection = moveDirection + Vector3.new(0, 1, 0) end -- บินขึ้น
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDirection = moveDirection - Vector3.new(0, 1, 0) end -- บินลง
			if moveDirection.Magnitude > 0 then                   -- ถ้ามีการกดปุ่มทิศทาง
				rootPart.CFrame = rootPart.CFrame + moveDirection.Unit * flySpeed * deltaTime -- ขยับตัวละครตามทิศทาง×ความเร็ว×เวลา
			end
		end)
	end
end

