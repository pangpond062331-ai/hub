-- ===================== คีย์ลัดที่เหลืออยู่ (B / T / F3 เท่านั้น) =====================
UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
	if gameProcessedEvent then return end                       -- ถ้ามี GUI/ช่องแชทรับเหตุการณ์ไปแล้ว (เช่นกำลังพิมพ์แชท) → ไม่ตอบสนอง
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end -- รับเฉพาะการกดคีย์บอร์ด
	local key = input.KeyCode                                   -- คีย์ที่กดเข้ามา
	if key == Enum.KeyCode.B then                               -- คีย์ B: เสก Part สีแดง 4x4x4 ตรงหน้าตัวละคร
		spawnTestPart()                                         -- เรียกฟังก์ชันเสก Part
	elseif key == Enum.KeyCode.T then                           -- คีย์ T: วาร์ปไปจุดที่เมาส์ชี้
		teleportToMouse()                                       -- เรียกฟังก์ชันวาร์ป
	elseif key == Enum.KeyCode.F3 then                          -- คีย์ F3: สลับโหมดวิ่งเร็ว
		setSpeedMode(not speedMode)                             -- สลับสถานะวิ่งเร็ว
		refreshToggles()                                        -- อัปเดตปุ่ม/ป้ายในเมนูให้ตรงสถานะ
	end
end)

-- ===================== ลูป FPS (นับจำนวนเฟรมต่อวินาที) =====================
RunService.RenderStepped:Connect(function()
	frameCount = frameCount + 1                                 -- เพิ่มตัวนับเฟรมทุกเฟรม
	local now = os.clock()                                      -- อ่านเวลาปัจจุบัน
	if now - lastFpsTime >= 1 then                              -- ผ่านไปครบ 1 วินาทีแล้ว
		fps = math.floor(frameCount / (now - lastFpsTime))       -- คำนวณ FPS = จำนวนเฟรม / เวลาที่ผ่านไป
		frameCount = 0                                           -- รีเซ็ตตัวนับเฟรม
		lastFpsTime = now                                        -- บันทึกเวลาอัปเดตล่าสุด
	end
end)

-- ===================== ลูป NoClip (ปิดการชนก่อนขั้นตอนฟิสิกส์ทุกเฟรม) =====================
RunService.Stepped:Connect(function()
	if noClipEnabled and character and character.Parent then     -- ถ้าเปิด NoClip และมีตัวละคร
		for _, part in ipairs(character:GetDescendants()) do      -- วนทุก Instance ภายในตัวละคร
			if part:IsA("BasePart") then                          -- เฉพาะ Part ที่มีรูปร่างเท่านั้น
				part.CanCollide = false                           -- ปิดการชน → เดินทะลุได้ (ทุกเฟรม)
			end
		end
	end
end)

-- ===================== ลูปหลัก Heartbeat (ประตูวาร์ป + อัปเดตข้อมูล Real-time) =====================
local lastInfoUpdate = 0                                        -- เวลาอัปเดตข้อมูลล่าสุด (ถี่ 4 ครั้ง/วินาที)
RunService.Heartbeat:Connect(function()
	-- 1) ตรวจจับการเดินเข้าไปในประตูวาร์ปที่สร้างไว้ (ระบบฝั่ง Client สำหรับทดสอบทันที)
	if rootPart and rootPart.Parent and #gates > 0 then          -- มีตัวละครและมีประตูที่ต้องตรวจ
		local now = os.clock()                                   -- อ่านเวลาปัจจุบันไว้เช็ค Cooldown
		for _, gateInfo in ipairs(gates) do                       -- วนตรวจประตูทุกบาน
			local gatePart = gateInfo.part                       -- Part ของประตูบานนี้
			if gatePart and gatePart.Parent                      -- ประตูยังอยู่ในเกม
				and now >= gateInfo.lastTeleport                 -- และพ้นคูลดาวน์ 2 วินาทีแล้ว
				and (rootPart.Position - gatePart.Position).Magnitude <= 40 then -- อยู่ใกล้ประตูไม่เกิน 40 สตั๊ด
				local localPosition = gatePart.CFrame:PointToObjectSpace(rootPart.Position) -- แปลงพิกัดตัวละครเป็นระบบพิกัดของประตู
				local half = gatePart.Size * 0.5                 -- ครึ่งหนึ่งของขนาดประตู (ขอบเขตตรวจจับ)
				local inside = math.abs(localPosition.X) <= half.X + 2  -- อยู่ในแนวกว้าง (เผื่อ 2 สตั๊ด)
					and math.abs(localPosition.Z) <= half.Z + 2          -- อยู่ในแนวหน้า-หลัง (เผื่อ 2 สตั๊ด)
					and math.abs(localPosition.Y) <= half.Y + 3          -- อยู่ในแนวสูง (เผื่อ 3 สตั๊ด)
				if inside then                                    -- ตัวละครเดินเข้าเขตประตูแล้ว
					gateInfo.lastTeleport = now + 2               -- ตั้งคูลดาวน์ 2 วินาที กันวาร์ปรัว
					task.spawn(fadeOverlay, function()            -- รัน Fade + วาร์ปแบบไม่บล็อกเฟรมเกม
						if rootPart and rootPart.Parent then       -- เช็คอีกครั้งว่าตัวภาพยังอยู่ในเกม
							rootPart.CFrame = gateInfo.exitCFrame  -- ย้ายตัวละครไปจุดปลายทาง (Point 2)
						end
					end)
				end
			end
		end
	end
	-- 2) คงค่าโหมดวิ่งเร็วไว้ (กันค่าถูกเขียนทับโดยสคริปต์อื่นในเกม หรือตอนตัวละครเพิ่งเกิด/respawn)
	if speedMode and humanoid and humanoid.Parent and humanoid.WalkSpeed ~= walkSpeedValue then
		humanoid.WalkSpeed = walkSpeedValue                       -- เขียนค่าความเร็วกลับทุกครั้งที่พบว่าถูกแก้
	end
	-- 3) อัปเดตข้อมูล Real-time บนแท็บหน้าหลัก (ถี่ประมาณ 4 ครั้ง/วินาที พอให้อ่านทัน)
	local now = os.clock()                                       -- อ่านเวลาปัจจุบัน
	if now - lastInfoUpdate >= 0.25 then                         -- ถ้าผ่านมา 0.25 วินาทีแล้ว
		lastInfoUpdate = now                                     -- บันทึกเวลาอัปเดตล่าสุด
		if ui.posLabel then                                      -- อัปเดตป้ายพิกัด
			ui.posLabel.Text = "พิกัดตัวละคร: "                  -- หัวข้อข้อความ
				.. (rootPart and rootPart.Parent and formatVector3(rootPart.Position) or "(ยังไม่มีตัวละคร)") -- พิกัดจริงหรือข้อความรอตัวละคร
		end
		if ui.fpsLabel then                                      -- อัปเดตป้าย FPS/Ping
			ui.fpsLabel.Text = string.format("FPS: %d | Ping: %d ms", fps, math.floor(player:GetNetworkPing() * 1000)) -- FPS จากตัวนับ + Ping เป็นมิลลิวินาที
		end
		if ui.timeLabel then                                     -- อัปเดตป้ายเวลาที่เปิดใช้งาน
			ui.timeLabel.Text = "เวลาที่เปิดใช้งาน: " .. formatDuration(os.clock() - scriptStartTime) -- เวลาที่ผ่านไปตั้งแต่สคริปต์เริ่มรัน
		end
		if aimbotEnabled then refreshAimCandidates() end         -- สแกนรายการเป้าหมายใหม่ทุก 0.25 วินาที ระหว่างเปิด Aimbot
	end
end)

