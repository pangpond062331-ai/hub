-- สีธีมของเมนู (โทนม่วง-ฟ้าไซเบอร์: พื้นเข้มอมม่วง ตัดด้วยแอ็กเซนต์ม่วงเรืองแสงและฟ้านีออน)
local COLOR_WINDOW = Color3.fromRGB(16, 15, 30)                 -- สีพื้นหน้าต่างหลัก (กรมท่าม่วงเข้ม)
local COLOR_BAR = Color3.fromRGB(28, 22, 52)                    -- สีแถบหัวเรื่อง/พื้นลิสต์ (ม่วงเข้ม)
