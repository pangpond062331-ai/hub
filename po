-- ฟังก์ชันช่วย: ใส่มุมโค้ง (UICorner) ให้ Instance ใดก็ได้
local function addCorner(inst, radius)
	local corner = Instance.new("UICorner")                      -- สร้าง UICorner
	corner.CornerRadius = UDim.new(0, radius or 6)               -- ตั้งรัศมีความโค้ง (ค่าเริ่มต้น 6px)
	corner.Parent = inst                                         -- ผูกกับ Instance เป้าหมาย
	return corner                                                -- คืน instance ไว้ใช้ต่อถ้าต้องการ
end

-- ฟังก์ชันช่วย: สร้างปุ่มกดทั่วไป (มีเอฟเฟกต์ตอนเอาเมาส์ไปวาง)
local function makeButton(text, parent, size, position, callback)
	local button = Instance.new("TextButton")                    -- สร้างปุ่ม
	button.Size = size                                           -- กำหนดขนาด
	button.Position = position                                   -- กำหนดตำแหน่ง
	button.BackgroundColor3 = COLOR_BTN                          -- สีพื้นปุ่มปกติ
	button.TextColor3 = COLOR_TEXT                               -- สีตัวอักษร
	button.Font = FONT                                           -- ฟอนต์
	button.TextSize = 14                                         -- ขนาดตัวอักษร
	button.Text = text                                           -- ข้อความบนปุ่ม
	button.AutoButtonColor = false                               -- ปิดเอฟเฟกต์กดของ Roblox (ใช้สี hover ของเราเอง)
	addCorner(button, 6)                                        -- ทำมุมโค้ง
	button.MouseEnter:Connect(function() button.BackgroundColor3 = COLOR_BTN_HOVER end) -- ตอนเอาเมาส์ไปวาง → สีสว่างขึ้น
	button.MouseLeave:Connect(function() button.BackgroundColor3 = COLOR_BTN end)       -- ตอนเอาเมาส์ออก → สีกลับปกติ
	button.MouseButton1Click:Connect(function()                  -- ตอนคลิกปุ่ม
		if callback then callback() end                          -- รันฟังก์ชันที่ผูกไว้ (ถ้ามี)
	end)
	button.Parent = parent                                       -- ใส่ปุ่มเข้าไปใน Container
	return button                                                -- คืนปุ่มไว้ใช้ต่อถ้าต้องการ
end

-- ฟังก์ชันช่วย: สร้างปุ่ม Toggle (เปิด/ปิด) — สีและข้อความเปลี่ยนตามสถานะจริง
local function makeToggleButton(name, parent, size, position, getState, onToggle)
	local button = Instance.new("TextButton")                    -- สร้างปุ่ม
	button.Size = size                                           -- กำหนดขนาด
	button.Position = position                                   -- กำหนดตำแหน่ง
	button.BackgroundColor3 = COLOR_BTN                          -- สีพื้นเริ่มต้น (ปิด)
	button.TextColor3 = COLOR_TEXT                               -- สีตัวอักษรเริ่มต้น
	button.Font = FONT                                           -- ฟอนต์
	button.TextSize = 14                                         -- ขนาดตัวอักษร
	button.Text = name                                           -- ข้อความเริ่มต้น
	button.AutoButtonColor = false                               -- ปิดเอฟเฟกต์กดของ Roblox
	addCorner(button, 6)                                        -- ทำมุมโค้ง
	button.MouseEnter:Connect(function()                         -- ตอนเอาเมาส์ไปวาง
		if not getState() then button.BackgroundColor3 = COLOR_BTN_HOVER end -- ถ้าสถานะปิดอยู่ → สีสว่างขึ้น
	end)
	button.MouseLeave:Connect(function()                         -- ตอนเอาเมาส์ออก
		if not getState() then button.BackgroundColor3 = COLOR_BTN end       -- ถ้าสถานะปิดอยู่ → สีกลับปกติ
	end)
	button.MouseButton1Click:Connect(function()                  -- ตอนคลิกปุ่ม
		onToggle()                                               -- เปลี่ยนสถานะของระบบ
		refreshToggles()                                         -- อัปเดตสี/ข้อความปุ่มทุกจุดให้ตรงสถานะใหม่
	end)
	button.Parent = parent                                       -- ใส่ปุ่มเข้า Container
	table.insert(toggleRegistry, {                               -- บันทึกลงทะเบียน toggle เพื่อ refresh พร้อมกัน
		button = button,                                         -- อ้างอิงปุ่ม
		name = name,                                             -- ชื่อไว้แสดงผลบนปุ่ม
		getState = getState,                                     -- ฟังก์ชันเช็คสถานะ
	})
	return button                                                -- คืนปุ่ม
end

-- ฟังก์ชันช่วย: สร้างป้ายข้อความ (ตัดบรรทัดอัตโนมัติ ชิดซ้าย)
