-- ===================== Boost FPS (ดินน้ำมัน) — เขียนใหม่ =====================
-- แต่ละชิ้นครอบ pcall เพื่อไม่ให้ error ชิ้นเดียวทำให้ทั้งระบบหยุด
local function boostInstance(inst, b)
	if character and inst:IsDescendantOf(character) then return end
	pcall(function()
		if inst:IsA("ParticleEmitter") then
			table.insert(b.enabled, { inst, inst.Enabled }); inst.Enabled = false
		elseif inst:IsA("Beam") then
			table.insert(b.enabled, { inst, inst.Enabled }); inst.Enabled = false
		elseif inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles") then
			table.insert(b.enabled, { inst, inst.Enabled }); inst.Enabled = false
		elseif inst:IsA("Trail") then
			table.insert(b.trails, { inst, inst.Transparency }); inst.Transparency = NumberSequence.new(1)
		elseif inst:IsA("Terrain") then
			-- Terrain ตั้งวัสดุไม่ได้ → ปิดหญ้า/คลื่นน้ำแทน
			if not b.terrain then
				b.terrain = { inst.Decoration, inst.WaterWaveSize, inst.WaterWaveSpeed, inst.WaterReflectance }
				inst.Decoration = false
				inst.WaterWaveSize = 0
				inst.WaterWaveSpeed = 0
				inst.WaterReflectance = 0
			end
		elseif inst:IsA("BasePart") then
			if inst.Material ~= Enum.Material.SmoothPlastic then
				table.insert(b.materials, { inst, inst.Material }); inst.Material = Enum.Material.SmoothPlastic
			end
			if inst.Reflectance > 0 then
				table.insert(b.reflect, { inst, inst.Reflectance }); inst.Reflectance = 0
			end
			if inst.CastShadow then
				table.insert(b.shadows, { inst }); inst.CastShadow = false
			end
			if inst:IsA("MeshPart") and inst.TextureID ~= "" then
				table.insert(b.meshTex, { inst, inst.TextureID }); inst.TextureID = ""
			end
		elseif inst:IsA("SurfaceAppearance") then
			-- SurfaceAppearance ไม่มี Enabled → ถอดออกชั่วคราว (เก็บ parent ไว้คืน)
			table.insert(b.surfaces, { inst, inst.Parent }); inst.Parent = nil
		elseif inst:IsA("Texture") or inst:IsA("Decal") then
			table.insert(b.textures, { inst, inst.Texture }); inst.Texture = ""
		elseif inst:IsA("Highlight") then
			-- ห้ามแตะ Highlight ของ ESP เราเอง (ไม่งั้น Boost จะปิด ESP ของเราด้วย)
			if string.sub(inst.Name, 1, 7) ~= "DevESP_" then
				table.insert(b.enabled, { inst, inst.Enabled }); inst.Enabled = false
			end
		end
	end)
end

