local function buildGateSource(exitCFrame)
	local pos = exitCFrame.Position
	local _, yaw = exitCFrame:ToEulerAnglesYXZ()
	local result = GATE_SOURCE_TEMPLATE
	result = string.gsub(result, "__X__", tostring(pos.X))
	result = string.gsub(result, "__Y__", tostring(pos.Y))
	result = string.gsub(result, "__Z__", tostring(pos.Z))
	result = string.gsub(result, "__YAW__", tostring(math.deg(yaw)))
	return result
end

local function buildGate()
	if not point1 then print("[DevUtilityV2] ยังไม่ได้บันทึก Point 1") return end
	if not rootPart then print("[DevUtilityV2] ยังไม่มีตัวละคร") return end
	point2 = rootPart.CFrame
	local gate = Instance.new("Part")
	gate.Name = "TeleportGate"
	gate.Size = Vector3.new(8, 10, 1)
	gate.Color = Color3.fromRGB(0, 140, 255)
	gate.Transparency = 0.5
	gate.Material = Enum.Material.Neon
	gate.Anchored = true
	gate.CanCollide = false
	local floorPos = point1.Position - Vector3.new(0, 3, 0)
	local gatePos = floorPos + Vector3.new(0, gate.Size.Y / 2, 0)
	local _, yaw = point1:ToEulerAnglesYXZ()
	gate.CFrame = CFrame.new(gatePos) * CFrame.Angles(0, yaw, 0)
	gate.Parent = workspace
	local source = buildGateSource(point2)
	local gateScript = Instance.new("Script")
	gateScript.Name = "TeleportGateHandler"
	local ok, err = pcall(function() gateScript.Source = source end)
	if not ok then
		local stash = Instance.new("StringValue")
		stash.Name = "SourceCode_คัดลอกไปใส่ในScript"
		stash.Value = source
		stash.Parent = gate
		print("[DevUtilityV2] เขียน Script.Source ไม่ได้ (" .. tostring(err) .. ") → เก็บซอร์สใน StringValue")
	end
	gateScript.Parent = gate
	gates[#gates + 1] = { part = gate, exitCFrame = point2, lastTeleport = 0 }
	print("[DevUtilityV2] สร้างประตูวาร์ปแล้ว | P1: " .. formatVector3(point1.Position) .. " | P2: " .. formatVector3(point2.Position))
	print("[DevUtilityV2] ===== ซอร์สสคริปต์วาร์ป =====\n" .. source .. "\n===== จบ =====")
end

local function cleanUp()
	local removed = 0
	for i = #spawnedParts, 1, -1 do
		local p = spawnedParts[i]
		if p and p.Parent then p:Destroy() removed = removed + 1 end
		spawnedParts[i] = nil
	end
	for i = #gates, 1, -1 do
		local g = gates[i]
		if g.part and g.part.Parent then g.part:Destroy() removed = removed + 1 end
		gates[i] = nil
	end
	print("[DevUtilityV2] Clean Up: ลบ " .. removed .. " ชิ้น")
end

local function saveWaypoint()
	if not rootPart then print("[DevUtilityV2] ยังไม่มีตัวละคร") return end
	waypointCounter = waypointCounter + 1
	table.insert(waypoints, { name = "จุดที่ " .. waypointCounter, cFrame = rootPart.CFrame })
	rebuildWaypointList()
	refreshToggles()
end

local function teleportToWaypoint(index)
	local wp = waypoints[index]
	if not wp or not rootPart then return end
	rootPart.CFrame = wp.cFrame
end

local function deleteWaypoint(index)
	table.remove(waypoints, index)
	rebuildWaypointList()
	refreshToggles()
end

local function teleportToMouse()
	local hit = getMouseHit()
	if rootPart and hit then
		local target = hit.Position + Vector3.new(0, 3, 0)
		local cf = rootPart.CFrame
		rootPart.CFrame = CFrame.new(target) * (cf - cf.Position)
		print("[DevUtilityV2] วาร์ปไปยัง " .. formatVector3(target))
	elseif not hit then
		print("[DevUtilityV2] ไม่พบพื้นผิวที่เมาส์ชี้")
	else
		print("[DevUtilityV2] ยังไม่มีตัวละคร")
	end
end

-- ===================== Boost FPS (ดินน้ำมัน) — เขียนใหม่ =====================
-- แต่ละชิ้นครอบ pcall เพื่อไม่ให้ error ชิ้นเดียวทำให้ทั้งระบบหยุด
local function boostInstance(inst, b)
	if character and inst:IsDescendantOf(character) then return end
	pcall(function()
		if inst:IsA("ParticleEmitter") then
			table.insert(b.enabled, { inst, inst.Enabled }); inst.Enabled = false
		elseif inst:IsA("Beam") then
			table.insert(b.enabled, { inst, inst.Enabled }); inst.Enabled = false
		elseif inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles") then
			table.insert(b.enabled, { inst, inst.Enabled }); inst.Enabled = false
		elseif inst:IsA("Trail") then
			table.insert(b.trails, { inst, inst.Transparency }); inst.Transparency = NumberSequence.new(1)
		elseif inst:IsA("Terrain") then
			-- Terrain ตั้งวัสดุไม่ได้ → ปิดหญ้า/คลื่นน้ำแทน
			if not b.terrain then
				b.terrain = { inst.Decoration, inst.WaterWaveSize, inst.WaterWaveSpeed, inst.WaterReflectance }
				inst.Decoration = false
				inst.WaterWaveSize = 0
				inst.WaterWaveSpeed = 0
				inst.WaterReflectance = 0
			end
		elseif inst:IsA("BasePart") then
			if inst.Material ~= Enum.Material.SmoothPlastic then
				table.insert(b.materials, { inst, inst.Material }); inst.Material = Enum.Material.SmoothPlastic
			end
			if inst.Reflectance > 0 then
				table.insert(b.reflect, { inst, inst.Reflectance }); inst.Reflectance = 0
			end
			if inst.CastShadow then
				table.insert(b.shadows, { inst }); inst.CastShadow = false
			end
			if inst:IsA("MeshPart") and inst.TextureID ~= "" then
				table.insert(b.meshTex, { inst, inst.TextureID }); inst.TextureID = ""
			end
		elseif inst:IsA("SurfaceAppearance") then
			-- SurfaceAppearance ไม่มี Enabled → ถอดออกชั่วคราว (เก็บ parent ไว้คืน)
			table.insert(b.surfaces, { inst, inst.Parent }); inst.Parent = nil
		elseif inst:IsA("Texture") or inst:IsA("Decal") then
			table.insert(b.textures, { inst, inst.Texture }); inst.Texture = ""
		elseif inst:IsA("Highlight") then
			table.insert(b.enabled, { inst, inst.Enabled }); inst.Enabled = false
		end
	end)
end

local function applyBoostFPS()
	if boostBackup then return "Boost FPS ทำงานอยู่แล้ว" end
	local b = {
		quality = nil,
		fogStart = Lighting.FogStart, fogEnd = Lighting.FogEnd,
		envSpecular = Lighting.EnvironmentSpecularScale, envDiffuse = Lighting.EnvironmentDiffuseScale,
		globalShadows = Lighting.GlobalShadows,
		effects = {}, atmospheres = {},
		enabled = {}, trails = {}, materials = {}, reflect = {}, shadows = {}, meshTex = {},
		surfaces = {}, textures = {}, terrain = nil,
	}
	boostBackup = b -- ตั้งก่อน เพื่อให้สถานะ/ปุ่มเปลี่ยนเป็น "เปิด" ทันที

	pcall(function()
		b.quality = settings().Rendering.QualityLevel
		settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
	end)

	-- Lighting: ปิดเอฟเฟกทุกชนิด + หมอก + เงา + การสะท้อน
	pcall(function()
		for _, child in ipairs(Lighting:GetChildren()) do
			if child:IsA("PostEffect") then
				table.insert(b.effects, { child, child.Enabled }); child.Enabled = false
			elseif child:IsA("Atmosphere") then
				table.insert(b.atmospheres, { child, child.Density, child.Offset })
				child.Density = 0; child.Offset = 0
			end
		end
		Lighting.FogStart = 0
		Lighting.FogEnd = 100000000
		Lighting.EnvironmentSpecularScale = 0
		Lighting.EnvironmentDiffuseScale = 0
		Lighting.GlobalShadows = false
	end)

	-- ของใหม่ที่โหลดเข้ามาทีหลัง (เช่น StreamingEnabled) ก็แปลงด้วย
	boostAddedConn = workspace.DescendantAdded:Connect(function(inst)
		if boostBackup == b then boostInstance(inst, b) end
	end)

	-- วนแปลงทั้ง Workspace เป็นชุด ๆ ไม่ให้เกมค้าง
	task.spawn(function()
		local count = 0
		for _, inst in ipairs(workspace:GetDescendants()) do
			if boostBackup ~= b then return end -- ถูกปิดระหว่างทำ → หยุด
			boostInstance(inst, b)
			count = count + 1
			if count % 400 == 0 then task.wait() end
		end
		if ui.boostSummary and boostBackup == b then
			ui.boostSummary.Text = string.format(
				"เปิด Boost FPS (ดินน้ำมัน) เสร็จแล้ว\nเปลี่ยนวัสดุ %d ชิ้น | ล้างเท็กซ์เจอร์ %d | ถอดพื้นผิว PBR %d\nปิดเอฟเฟกอนุภาค/ลำแสง/ไฟ %d | PostEffect %d | ปิดเงา %d ชิ้น",
				#b.materials, #b.textures + #b.meshTex, #b.surfaces, #b.enabled, #b.effects, #b.shadows)
		end
	end)

	return "กำลังแปลงเป็นดินน้ำมัน... (ทำทีละชุด ไม่ให้เกมค้าง)"
end

local function restoreBoostFPS()
	if not boostBackup then return "ยังไม่ได้เปิด Boost FPS" end
	local b = boostBackup
	boostBackup = nil -- ตั้งก่อน เพื่อหยุดลูปแปลงที่ค้างอยู่
	if boostAddedConn then boostAddedConn:Disconnect() boostAddedConn = nil end

	pcall(function() if b.quality then settings().Rendering.QualityLevel = b.quality end end)
	pcall(function()
		for _, it in ipairs(b.effects) do if it[1].Parent then it[1].Enabled = it[2] end end
		for _, it in ipairs(b.atmospheres) do
			if it[1].Parent then it[1].Density = it[2]; it[1].Offset = it[3] end
		end
		Lighting.FogStart = b.fogStart
		Lighting.FogEnd = b.fogEnd
		Lighting.EnvironmentSpecularScale = b.envSpecular
		Lighting.EnvironmentDiffuseScale = b.envDiffuse
		Lighting.GlobalShadows = b.globalShadows
	end)

	local function each(list, fn)
		for i, it in ipairs(list) do
			pcall(fn, it)
			if i % 400 == 0 then task.wait() end
		end
	end
	task.spawn(function()
		each(b.enabled, function(it) if it[1].Parent then it[1].Enabled = it[2] end end)
		each(b.trails, function(it) if it[1].Parent then it[1].Transparency = it[2] end end)
		each(b.materials, function(it) if it[1].Parent then it[1].Material = it[2] end end)
		each(b.reflect, function(it) if it[1].Parent then it[1].Reflectance = it[2] end end)
		each(b.shadows, function(it) if it[1].Parent then it[1].CastShadow = true end end)
		each(b.meshTex, function(it) if it[1].Parent then it[1].TextureID = it[2] end end)
		each(b.surfaces, function(it) if it[2] and it[2].Parent then it[1].Parent = it[2] end end)
		each(b.textures, function(it) if it[1].Parent then it[1].Texture = it[2] end end)
		if b.terrain then
			pcall(function()
				local t = workspace.Terrain
				t.Decoration, t.WaterWaveSize, t.WaterWaveSpeed, t.WaterReflectance = b.terrain[1], b.terrain[2], b.terrain[3], b.terrain[4]
			end)
		end
		if ui.boostSummary then ui.boostSummary.Text = "คืนสภาพกราฟฟิกเดิมเรียบร้อยแล้ว" end
	end)
	return "กำลังคืนสภาพกราฟฟิกเดิม..."
end

