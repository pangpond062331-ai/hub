local function setInvisibility(enabled)
	local remote = ReplicatedStorage:FindFirstChild("DevInvsRemote")
	local ready = remote ~= nil and remote:IsA("RemoteEvent")
	if not ready then
		-- ยังไม่ได้ติดตั้งสคริปต์เซิร์ฟ → แจ้ง + ดัมป์ซอร์สให้คัดลอก (เหมือนระบบประตูวาร์ป)
		devLog("lgInvsNeedServer")
		if enabled then
			print("[DevUtilityV2] ===== ซอร์สสคริปต์โหมดหายตัว (วางใน ServerScriptService) =====\n" .. INVIS_SERVER_SOURCE .. "\n===== จบ =====")
			local stashName = "SourceCode_โหมดหายตัว_คัดลอกไปใส่ในScript"
			if not ReplicatedStorage:FindFirstChild(stashName) then
				local stash = Instance.new("StringValue")
				stash.Name = stashName
				stash.Value = INVIS_SERVER_SOURCE
				stash.Parent = ReplicatedStorage
			end
		end
		invisEnabled = false
	else
		invisEnabled = enabled
		remote:FireServer(invisEnabled)
		devLog(invisEnabled and "lgInvisOn" or "lgInvisOff")
	end
	if refreshToggles then refreshToggles() end
end

