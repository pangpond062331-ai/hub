	frameCount = frameCount + 1
	local now = os.clock()
	if now - lastFpsTime >= 1 then
		fps = math.floor(frameCount / (now - lastFpsTime))
		frameCount = 0
		lastFpsTime = now
	end
end)

-- NoClip + คงค่าวิ่งเร็วก่อนฟิสิกส์ทุกเฟรม
RunService.Stepped:Connect(function()
	if noClipEnabled and character and character.Parent then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then part.CanCollide = false end
		end
	end
	if speedMode then applyWalkSpeed() end
end)

local lastInfoUpdate = 0
RunService.Heartbeat:Connect(function()
	-- บังคับ FOV กล้องถ้าเปิดปรับไว้ (เกมอาจทับตอน respawn/ซูม)
	if camFovLock then
		local cam = workspace.CurrentCamera
		if cam and cam.FieldOfView ~= camFovLock then cam.FieldOfView = camFovLock end
	end

	-- ประตูวาร์ปฝั่ง Client
	if rootPart and rootPart.Parent and #gates > 0 then
		local now = os.clock()
		for _, g in ipairs(gates) do
			local gp = g.part
			if gp and gp.Parent and now >= g.lastTeleport and (rootPart.Position - gp.Position).Magnitude <= 40 then
				local lp = gp.CFrame:PointToObjectSpace(rootPart.Position)
				local half = gp.Size * 0.5
				if math.abs(lp.X) <= half.X + 2 and math.abs(lp.Z) <= half.Z + 2 and math.abs(lp.Y) <= half.Y + 3 then
					g.lastTeleport = now + 2
					task.spawn(fadeOverlay, function()
						if rootPart and rootPart.Parent then rootPart.CFrame = g.exitCFrame end
					end)
				end
			end
		end
	end

	if speedMode then applyWalkSpeed() end

	-- อัปเดตข้อมูล Real-time 4 ครั้ง/วินาที
	local now = os.clock()
	if now - lastInfoUpdate >= 0.25 then
		lastInfoUpdate = now
		local pingMs = math.floor(player:GetNetworkPing() * 1000)
		ui.posLabel.Text = T("homePos") .. (rootPart and rootPart.Parent and formatVector3(rootPart.Position) or T("noChar"))
		ui.fpsLabel.Text = string.format("FPS: %d | Ping: %d ms", fps, pingMs)
		ui.timeLabel.Text = T("uptime") .. formatDuration(os.clock() - scriptStartTime)
		ui.serverLabel.Text = string.format(T("serverInfo"), #Players:GetPlayers(), Players.MaxPlayers, game.JobId)
		-- 📈 กราฟ FPS/Ping: เก็บตัวอย่างล่าสุด (ข้ามเฟรมแรกที่ fps = 0)
		if fps > 0 then
			table.insert(fpsHistory, fps)
			table.insert(pingHistory, pingMs)
			while #fpsHistory > FPS_GRAPH_SAMPLES do table.remove(fpsHistory, 1) end
			while #pingHistory > FPS_GRAPH_SAMPLES do table.remove(pingHistory, 1) end
		end
		if #fpsHistory > 0 then
			local fmin, fmax, fsum = math.huge, -math.huge, 0
			local pmin, pmax, psum = math.huge, -math.huge, 0
			for i, v in ipairs(fpsHistory) do
				fsum = fsum + v
				if v < fmin then fmin = v end
				if v > fmax then fmax = v end
				local p = pingHistory[i]
				psum = psum + p
				if p < pmin then pmin = p end
				if p > pmax then pmax = p end
			end
			local n = #fpsHistory
			lastStats.fmin = math.floor(fmin); lastStats.fmax = math.floor(fmax); lastStats.favg = fsum / n
			lastStats.pmin = math.floor(pmin); lastStats.pmax = math.floor(pmax); lastStats.pavg = psum / n
		end
		updateStatsLabel()
		-- วาดแท่งกราฟ: สีบอกประสิทธิภาพ (เขียว ≥55 / เหลือง ≥30 / แดง <30) — คงสีสัญลักษณ์ ไม่ผ่านธีม
		for i = 1, FPS_GRAPH_SAMPLES do
			local bar = fpsGraphBars[i]
			if bar then
				local v = fpsHistory[i]
				if v then
					bar.Size = UDim2.new(1 / FPS_GRAPH_SAMPLES, -2, 0, math.clamp(v / 60, 0.06, 1) * 38)
					bar.BackgroundColor3 = (v >= 55 and Color3.fromRGB(80, 200, 120))
						or (v >= 30 and Color3.fromRGB(230, 190, 60))
						or Color3.fromRGB(230, 90, 80)
					bar.Visible = true
				else
					bar.Visible = false
				end
			end
		end
		-- ระบบต่อสู้: รีเฟรช ESP / รายการเป้า / ค่ารีโหลด 4 ครั้ง/วินาที
		if espEnabled then refreshESP() end
		if aimbotEnabled then refreshAimCandidates() end
		if fastReloadEnabled then scanToolsForReload() end
		ui.statusLabel.Text = statusString()
	end
end)

