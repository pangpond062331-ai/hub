local function addCorner(inst, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 6)
	c.Parent = inst
	return c
end

local function makeButton(text, parent, size, position, callback)
	local button = Instance.new("TextButton")
	button.Size = size
	button.Position = position
	button.BackgroundColor3 = COLOR_BTN
	button.TextColor3 = COLOR_TEXT
	button.Font = FONT
	button.TextSize = 14
	button.Text = text
	button.AutoButtonColor = false
	addCorner(button, 6)
	button.MouseEnter:Connect(function() button.BackgroundColor3 = COLOR_BTN_HOVER end)
	button.MouseLeave:Connect(function() button.BackgroundColor3 = COLOR_BTN end)
	button.MouseButton1Click:Connect(function() if callback then callback() end end)
	button.Parent = parent
	return button
end

local function makeToggleButton(name, parent, size, position, getState, onToggle)
	local button = Instance.new("TextButton")
	button.Size = size
	button.Position = position
	button.BackgroundColor3 = COLOR_BTN
	button.TextColor3 = COLOR_TEXT
	button.Font = FONT
	button.TextSize = 14
	button.Text = name
	button.AutoButtonColor = false
	addCorner(button, 6)
	button.MouseEnter:Connect(function() if not getState() then button.BackgroundColor3 = COLOR_BTN_HOVER end end)
	button.MouseLeave:Connect(function() if not getState() then button.BackgroundColor3 = COLOR_BTN end end)
	button.MouseButton1Click:Connect(function()
		onToggle()
		refreshToggles()
	end)
	button.Parent = parent
	table.insert(toggleRegistry, { button = button, name = name, getState = getState })
	return button
end

local function makeLabel(text, parent, size, position, textColor, textSize)
	local label = Instance.new("TextLabel")
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.Font = FONT
	label.TextSize = textSize or 14
	label.TextColor3 = textColor or COLOR_TEXT
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.TextWrapped = true
	label.Text = text
	label.Parent = parent
	return label
end

-- สไลเดอร์ (รองรับทั้งเมาส์และทัช)
local function makeSlider(parent, containerY, labelText, minValue, maxValue, initialValue, onChange)
	local value = initialValue
	local fraction = (initialValue - minValue) / (maxValue - minValue)

	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, 0, 0, 44)
	container.Position = UDim2.new(0, 0, 0, containerY)
	container.BackgroundTransparency = 1
	container.Parent = parent

	local caption = Instance.new("TextLabel")
	caption.Size = UDim2.new(1, 0, 0, 18)
	caption.BackgroundTransparency = 1
	caption.Font = FONT
	caption.TextSize = 13
	caption.TextColor3 = COLOR_TEXT
	caption.TextXAlignment = Enum.TextXAlignment.Left
	caption.Text = labelText .. ": " .. value
	caption.Parent = container

	local track = Instance.new("Frame")
	track.Size = UDim2.new(1, 0, 0, 8)
	track.Position = UDim2.new(0, 0, 0, 30)
	track.BackgroundColor3 = COLOR_BTN
	track.BorderSizePixel = 0
	track.Parent = container
	addCorner(track, 4)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(fraction, 0, 1, 0)
	fill.BackgroundColor3 = COLOR_ACCENT
	fill.BorderSizePixel = 0
	fill.Parent = track
	addCorner(fill, 4)

	local knob = Instance.new("TextButton")
	knob.Size = UDim2.new(0, 18, 0, 18)
	knob.Position = UDim2.new(fraction, -9, 0.5, -9)
	knob.BackgroundColor3 = COLOR_TEXT
	knob.Text = ""
	knob.AutoButtonColor = false
	knob.Parent = track
	addCorner(knob, 9)

	local isDragging = false

	local function setFromFraction(f)
		fraction = math.clamp(f, 0, 1)
		value = math.floor(minValue + (maxValue - minValue) * fraction + 0.5)
		fill.Size = UDim2.new(fraction, 0, 1, 0)
		knob.Position = UDim2.new(fraction, -9, 0.5, -9)
		caption.Text = labelText .. ": " .. value
		if onChange then onChange(value) end
	end

	local function fractionFromInput(input)
		local w = math.max(track.AbsoluteSize.X, 1)
		return (input.Position.X - track.AbsolutePosition.X) / w
	end

	local function isDown(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
	end
	local function isMove(input)
		return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
	end

	knob.InputBegan:Connect(function(input) if isDown(input) then isDragging = true end end)
	track.InputBegan:Connect(function(input)
		if isDown(input) then
			isDragging = true
			setFromFraction(fractionFromInput(input))
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if isDragging and isMove(input) then setFromFraction(fractionFromInput(input)) end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if isDown(input) then isDragging = false end
	end)

	setFromFraction(fraction)
	return { caption = caption, setFromFraction = setFromFraction }
end

