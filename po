-- สไลเดอร์ (รองรับทั้งเมาส์และทัช) — ข้อความ caption ผูกกับ key ภาษา
local function makeSlider(parent, containerY, key, minValue, maxValue, initialValue, onChange)
	local value = initialValue
	local fraction = (initialValue - minValue) / (maxValue - minValue)

	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, 0, 0, 44)
	container.Position = UDim2.new(0, 0, 0, containerY)
	container.BackgroundTransparency = 1
	container.Parent = parent

	local caption = Instance.new("TextLabel")
	caption.Size = UDim2.new(1, 0, 0, 18)
	caption.BackgroundTransparency = 1
	caption.Font = FONT
	caption.TextSize = 13
	caption.TextColor3 = COLOR_TEXT
	caption.TextXAlignment = Enum.TextXAlignment.Left
	caption:SetAttribute("DevThemeRole", "text") -- ธีม
	caption.Text = T(key) .. ": " .. value
	caption.Parent = container

	local track = Instance.new("Frame")
	track.Size = UDim2.new(1, 0, 0, 8)
	track.Position = UDim2.new(0, 0, 0, 30)
	track.BackgroundColor3 = COLOR_BTN
	track.BorderSizePixel = 0
	track:SetAttribute("DevThemeRole", "button") -- ธีม
	track.Parent = container
	addCorner(track, 4)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(fraction, 0, 1, 0)
	fill.BackgroundColor3 = COLOR_ACCENT
	fill.BorderSizePixel = 0
	fill:SetAttribute("DevThemeRole", "accentFill") -- ธีม
	fill.Parent = track
	addCorner(fill, 4)

	local knob = Instance.new("TextButton")
	knob.Size = UDim2.new(0, 18, 0, 18)
	knob.Position = UDim2.new(fraction, -9, 0.5, -9)
	knob.BackgroundColor3 = COLOR_TEXT
	knob.Text = ""
	knob.AutoButtonColor = false
	knob:SetAttribute("DevThemeRole", "knob") -- ธีม
	knob.Parent = track
	addCorner(knob, 9)

	local isDragging = false

	local function getValue()
		return value
	end

	local function setFromFraction(f)
		fraction = math.clamp(f, 0, 1)
		value = math.floor(minValue + (maxValue - minValue) * fraction + 0.5)
		fill.Size = UDim2.new(fraction, 0, 1, 0)
		knob.Position = UDim2.new(fraction, -9, 0.5, -9)
		caption.Text = T(key) .. ": " .. value
		if onChange then onChange(value) end
	end

	local function fractionFromInput(input)
		local w = math.max(track.AbsoluteSize.X, 1)
		return (input.Position.X - track.AbsolutePosition.X) / w
	end

	local function isDown(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
	end
	local function isMove(input)
		return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
	end

	knob.InputBegan:Connect(function(input) if isDown(input) then isDragging = true end end)
	track.InputBegan:Connect(function(input)
		if isDown(input) then
			isDragging = true
			setFromFraction(fractionFromInput(input))
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if isDragging and isMove(input) then setFromFraction(fractionFromInput(input)) end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if isDown(input) then isDragging = false end
	end)

	table.insert(sliderRegistry, { caption = caption, key = key, getValue = getValue })
	setFromFraction(fraction)
	return { caption = caption, setFromFraction = setFromFraction, getValue = getValue }
end

-- สร้างชุดสีธีมจากโทนสี (HSL) — เรียกแล้ว COLOR_* เปลี่ยน → hover/ปุ่มใหม่ใช้ค่าใหม่ตามไปด้วย
local function hslToColor(h, s, l)
	h = h % 360
	local c = (1 - math.abs(2 * l - 1)) * s
	local x = c * (1 - math.abs((h / 60) % 2 - 1))
	local m = l - c / 2
	local r, g, b = 0, 0, 0
	if h < 60 then r, g, b = c, x, 0
	elseif h < 120 then r, g, b = x, c, 0
	elseif h < 180 then r, g, b = 0, c, x
	elseif h < 240 then r, g, b = 0, x, c
	elseif h < 300 then r, g, b = x, 0, c
	else r, g, b = c, 0, x end
	return Color3.fromRGB(math.floor((r + m) * 255 + 0.5), math.floor((g + m) * 255 + 0.5), math.floor((b + m) * 255 + 0.5))
end

local function themeFromHue(h)
	COLOR_ACCENT  = hslToColor(h, 0.62, 0.66)
	COLOR_ACCENT2 = hslToColor(h + 180, 0.7, 0.6)
	COLOR_BAR     = hslToColor(h, 0.42, 0.14)
	COLOR_BTN     = hslToColor(h, 0.38, 0.2)
	COLOR_BTN_HOVER = hslToColor(h, 0.45, 0.3)
	COLOR_TEXT    = hslToColor(h, 0.25, 0.93)
	COLOR_DIM     = hslToColor(h, 0.3, 0.62)
	COLOR_DARK    = hslToColor(h, 0.45, 0.07)
end

