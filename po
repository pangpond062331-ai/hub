local function devLog(key, ...)
	local args = { ... }
	table.insert(logEntries, { key = key, args = args, time = os.clock() })
	while #logEntries > MAX_LOG do table.remove(logEntries, 1) end
	local thText = STR.th[key] or key
	local ok, formatted = pcall(string.format, thText, table.unpack(args))
	print("[DevUtilityV2] " .. (ok and formatted or thText))
	if renderLog then renderLog() end
end

