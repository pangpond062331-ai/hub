UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	local key = input.KeyCode
	if key == Enum.KeyCode.B then
		spawnTestPart()
	elseif key == Enum.KeyCode.T then
		teleportToMouse()
	elseif key == Enum.KeyCode.F3 then
		setSpeedMode(not speedMode)
		refreshToggles()
	end
end)

-- ===================== ลูปต่าง ๆ =====================
RunService.RenderStepped:Connect(function()
	frameCount = frameCount + 1
	local now = os.clock()
	if now - lastFpsTime >= 1 then
		fps = math.floor(frameCount / (now - lastFpsTime))
		frameCount = 0
		lastFpsTime = now
	end
end)

-- NoClip + คงค่าวิ่งเร็วก่อนฟิสิกส์ทุกเฟรม
RunService.Stepped:Connect(function()
	if noClipEnabled and character and character.Parent then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then part.CanCollide = false end
		end
	end
	if speedMode then applyWalkSpeed() end
end)

local lastInfoUpdate = 0
RunService.Heartbeat:Connect(function()
	-- ประตูวาร์ปฝั่ง Client
	if rootPart and rootPart.Parent and #gates > 0 then
		local now = os.clock()
		for _, g in ipairs(gates) do
			local gp = g.part
			if gp and gp.Parent and now >= g.lastTeleport and (rootPart.Position - gp.Position).Magnitude <= 40 then
				local lp = gp.CFrame:PointToObjectSpace(rootPart.Position)
				local half = gp.Size * 0.5
				if math.abs(lp.X) <= half.X + 2 and math.abs(lp.Z) <= half.Z + 2 and math.abs(lp.Y) <= half.Y + 3 then
					g.lastTeleport = now + 2
					task.spawn(fadeOverlay, function()
						if rootPart and rootPart.Parent then rootPart.CFrame = g.exitCFrame end
					end)
				end
			end
		end
	end

	if speedMode then applyWalkSpeed() end

	-- อัปเดตข้อมูล Real-time 4 ครั้ง/วินาที
	local now = os.clock()
	if now - lastInfoUpdate >= 0.25 then
		lastInfoUpdate = now
		ui.posLabel.Text = "พิกัดตัวละคร: " .. (rootPart and rootPart.Parent and formatVector3(rootPart.Position) or "(ยังไม่มีตัวละคร)")
		ui.fpsLabel.Text = string.format("FPS: %d | Ping: %d ms", fps, math.floor(player:GetNetworkPing() * 1000))
		ui.timeLabel.Text = "เวลาที่เปิดใช้งาน: " .. formatDuration(os.clock() - scriptStartTime)
		ui.statusLabel.Text = statusString()
	end
end)
