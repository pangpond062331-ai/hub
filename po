-- เทมเพลตซอร์สโค้ดสคริปต์วาร์ปฝั่งเซิร์ฟเวอร์ (ฝังค่าปลายทางจริงด้วยการแทนค่า __X__ __Y__ __Z__ __YAW__)
local GATE_SOURCE_TEMPLATE = [==[
--[[
	สคริปต์วาร์ปประตู (Script ฝั่งเซิร์ฟเวอร์)
	วิธีใช้  : วาง Script นี้ไว้เป็นลูกของ Part ประตูวาร์ปใน Workspace
	หน้าที่  : ตรวจจับการแตะประตู → Fade หน้าจอดำ → วาร์ป → คูลดาวน์ 2 วินาที
	หมายเหตุ: ตำแหน่ง/มุมปลายทางถูกฝังเป็นค่าคงที่ตอนสร้างประตูจากเมนู
]]
local Players = game:GetService("Players")             -- ใช้หาผู้เล่นจากตัวละครที่แตะประตู
local TweenService = game:GetService("TweenService")   -- ใช้ทำเอฟเฟกต์ Fade หน้าจอดำ

local gate = script.Parent                             -- อ้างอิง Part ประตูวาร์ป (ต้องเป็นลูกของ Part)
local COOLDOWN_TIME = 2                                -- คูลดาวน์ 2 วินาที กันวาร์ปรัว
local FADE_TIME = 0.35                                 -- ระยะเวลา fade เข้า/ออก 1 รอบ (วินาที)
local EXIT_POSITION = Vector3.new(__X__, __Y__, __Z__) -- ตำแหน่งปลายทาง (ค่าจริงตอนกดสร้างประตู)
local EXIT_YAW = math.rad(__YAW__)                     -- มุมหันของตัวละคร ณ ปลายทาง (หน่วยองศา)

local lastTeleportTime = {}                            -- เก็บเวลาวาร์ปล่าสุดของผู้เล่นแต่ละคน

-- ฟังก์ชัน Fade หน้าจอดำ + วาร์ปตัวละคร (เรียกจากอีเวนต์ Touched)
local function fadeAndTeleport(targetPlayer, hitCharacter)
	local gui = Instance.new("ScreenGui")               -- สร้าง GUI ชั่วคราวสำหรับจอดำ
	gui.Name = "TeleportFadeGui"                        -- ตั้งชื่อ GUI
	gui.IgnoreGuiInset = true                           -- ครอบคลุมถึงแถบ UI ด้านบน
	gui.ResetOnSpawn = false                            -- ไม่ล้างตอนตัวละครเกิดใหม่
	gui.DisplayOrder = 9999                             -- ให้ทับ GUI อื่นทั้งหมด
	local frame = Instance.new("Frame")                 -- กรอบสีดำเต็มจอ
	frame.Size = UDim2.fromScale(1, 1)                  -- ครอบคลุมทั้งจอ
	frame.BackgroundColor3 = Color3.new(0, 0, 0)        -- สีดำสนิท
	frame.BackgroundTransparency = 1                    -- เริ่มโปร่งใส 100%
	frame.BorderSizePixel = 0                           -- ปิดเส้นขอบ
	frame.Parent = gui                                  -- ใส่ Frame เข้า GUI
	gui.Parent = targetPlayer:WaitForChild("PlayerGui") -- ใส่ GUI เข้า PlayerGui ของผู้เล่น
	local fadeIn = TweenService:Create(frame, TweenInfo.new(FADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0})
	fadeIn:Play()                                       -- เริ่ม fade เป็นสีดำ
	fadeIn.Completed:Wait()                             -- รอจนจอดำสนิท
	if hitCharacter and hitCharacter.Parent and hitCharacter:FindFirstChild("HumanoidRootPart") then
		hitCharacter.HumanoidRootPart.CFrame = CFrame.new(EXIT_POSITION) * CFrame.Angles(0, EXIT_YAW, 0)
	end                                                 -- ย้ายตัวละครไปตำแหน่งปลายทาง
	local fadeOut = TweenService:Create(frame, TweenInfo.new(FADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 1})
	fadeOut:Play()                                      -- เริ่ม fade กลับเป็นจอใส
	fadeOut.Completed:Wait()                            -- รอจนจอใสสนิท
	gui:Destroy()                                       -- ลบ GUI ชั่วคราวทิ้ง
end

-- หา Model ตัวละครจาก Part ที่แตะประตู (คืน nil ถ้าไม่ใช่ตัวละคร)
local function findCharacterFromHit(hitPart)
	local model = hitPart:FindFirstAncestorOfClass("Model")     -- หา ancestor ที่ใกล้ที่สุดซึ่งเป็น Model
	if model and model:FindFirstChildOfClass("Humanoid") then    -- Model ที่มี Humanoid = ตัวละคร
		return model                                             -- คืน Model ตัวละคร
	end
	return nil                                                   -- ไม่ใช่ตัวละคร → คืน nil
end

gate.Touched:Connect(function(hit)                      -- ฟังอีเวนต์ทุกครั้งที่มีอะไรแตะประตู
	local hitCharacter = findCharacterFromHit(hit)       -- หาตัวละครจากสิ่งที่แตะ
	if not hitCharacter then return end                  -- ไม่ใช่ตัวละคร → จบ
	local hitHumanoid = hitCharacter:FindFirstChildOfClass("Humanoid") -- ดึง Humanoid มาตรวจ
	if not hitHumanoid or hitHumanoid.Health <= 0 then return end      -- ไม่มี Humanoid/ตายแล้ว → ข้าม
	local touchPlayer = Players:GetPlayerFromCharacter(hitCharacter)   -- หาผู้เล่นที่เป็นเจ้าของตัวละคร
	if not touchPlayer then return end                   -- ไม่ใช่ผู้เล่น (เช่น NPC) → ข้าม
	local now = os.clock()                               -- เวลาระบบปัจจุบัน (วินาที)
	local last = lastTeleportTime[touchPlayer]           -- เวลาที่ผู้เล่นคนนี้วาร์ปล่าสุด
	if last and (now - last) < COOLDOWN_TIME then return end   -- ยังไม่ครบ 2 วิ → ห้ามวาร์ปซ้ำ
	lastTeleportTime[touchPlayer] = now                  -- บันทึกเวลาวาร์ปล่าสุดของผู้เล่นคนนี้
	task.spawn(fadeAndTeleport, touchPlayer, hitCharacter) -- รัน fade+วาร์ปแบบไม่บล็อกอีเวนต์
end)

