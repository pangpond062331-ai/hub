applyTheme = function()
	-- เดิน GUI ทั้งหมดแล้วทาสีตาม role ที่ติด Attribute ไว้ตอนสร้าง
	for _, inst in ipairs(screenGui:GetDescendants()) do
		local role = inst:GetAttribute("DevThemeRole")
		if role == "button" then
			inst.BackgroundColor3 = COLOR_BTN
			if inst:IsA("TextButton") then inst.TextColor3 = COLOR_TEXT end
		elseif role == "text" then
			inst.TextColor3 = COLOR_TEXT
		elseif role == "dim" then
			inst.TextColor3 = COLOR_DIM
		elseif role == "accent" then
			inst.TextColor3 = COLOR_ACCENT
		elseif role == "accentFill" then
			inst.BackgroundColor3 = COLOR_ACCENT
		elseif role == "knob" then
			inst.BackgroundColor3 = COLOR_TEXT
		elseif role == "bar" then
			inst.BackgroundColor3 = COLOR_BAR
		end
	end
	-- ส่วนที่ไม่ได้ติด role (gradient/ขอบ/ปุ่มเปิดเมนู/วงกลม FOV)
	windowGradient.Color = ColorSequence.new(hslToColor(themeHue, 0.42, 0.12), hslToColor(themeHue + 40, 0.5, 0.06))
	windowStroke.Color = COLOR_ACCENT
	barGradient.Color = ColorSequence.new(COLOR_ACCENT, COLOR_ACCENT2)
	coverGradient.Color = ColorSequence.new(COLOR_ACCENT, COLOR_ACCENT2)
	tabBar.BackgroundColor3 = COLOR_BAR
	sideDivider.BackgroundColor3 = COLOR_ACCENT2
	menuToggleButton.BackgroundColor3 = COLOR_ACCENT
	menuToggleButton.TextColor3 = COLOR_DARK
	fovStroke.Color = COLOR_ACCENT2
	if ui.fireButton then ui.fireButton.TextColor3 = COLOR_DARK end -- ปุ่ม 🔥 (พื้นหลังเด้งจาก accentFill แล้ว)
	-- ทาสีปุ่มสลับที่กำลัง "เปิด" + แท็บที่เลือกอยู่ใหม่
	refreshToggles()
	switchTab(currentTab)
end

-- ===================== แสดงผล Log ในแท็บประวัติ =====================
-- แปลง key → ข้อความตามภาษาปัจจุบันตอนแสดงผล (สลับภาษาแล้วของเก่าแปลใหม่ทันที)
renderLog = function()
	if not ui.logLabel then return end
	local lines = {}
	for _, e in ipairs(logEntries) do
		local text = T(e.key)
		if #e.args > 0 then
			local ok, formatted = pcall(string.format, text, table.unpack(e.args))
			if ok then text = formatted end
		end
		table.insert(lines, string.format("[%s] %s", formatDuration(os.clock() - e.time), text))
	end
	ui.logLabel.Text = (#lines > 0) and table.concat(lines, "\n") or T("logEmpty")
	if ui.logCountLabel then
		ui.logCountLabel.Text = string.format(T("logCount"), #logEntries, MAX_LOG)
	end
end

-- ===================== เปลี่ยนภาษาทั้งเมนู =====================
applyLanguage = function()
	-- 1) ป้ายข้อความนิ่งทั้งหมด: อัปเดตตาม key (ตัวที่ถูกทำลายแล้วจะถูกกวาดทิ้ง)
	for i = #textRegistry, 1, -1 do
		local entry = textRegistry[i]
		if not entry.inst.Parent then
			table.remove(textRegistry, i)
		else
			entry.inst.Text = T(entry.key)
		end
	end
	-- 2) ข้อความที่ประกอบเอง (สถานะ/ป้ายไดนามิก/ปุ่ม Waypoint/ข้อความ Boost)
	if refreshToggles then refreshToggles() end
	if rebuildWaypointList then rebuildWaypointList() end
	renderBoostSummary()
	switchTab(currentTab)
	if renderLog then renderLog() end -- แปลข้อความในประวัติใหม่ตามภาษาปัจจุบัน
	devLog("lgLang", lang == "th" and "ไทย" or "English")
end

toggleLanguage = function()
	lang = (lang == "th") and "en" or "th"
	applyLanguage()
end

