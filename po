-- คืนซอร์สโค้ดสคริปต์วาร์ปที่ฝังค่าตำแหน่ง/มุมปลายทาง (Point 2) เรียบร้อยแล้ว
local function buildGateSource(exitCFrame)
	local position = exitCFrame.Position                        -- ดึงเฉพาะตำแหน่ง (Vector3) ของจุดปลายทาง
	local _, yaw = exitCFrame:ToEulerAnglesYXZ()                 -- ดึงมุมหันรอบแกน Y (Yaw) ของจุดปลายทาง
	local result = GATE_SOURCE_TEMPLATE                         -- เริ่มจากเทมเพลตที่เตรียมไว้
	result = string.gsub(result, "__X__", tostring(position.X))        -- แทนที่ค่า X ด้วยค่าจริง
	result = string.gsub(result, "__Y__", tostring(position.Y))        -- แทนที่ค่า Y ด้วยค่าจริง
	result = string.gsub(result, "__Z__", tostring(position.Z))        -- แทนที่ค่า Z ด้วยค่าจริง
	result = string.gsub(result, "__YAW__", tostring(math.deg(yaw)))   -- แทนที่มุมหันด้วยหน่วยองศา
	return result                                                -- คืนซอร์สโค้ดที่สมบูรณ์
end

-- สร้างประตูวาร์ปที่ Point 1 พร้อมใส่ Script วาร์ป และพิมพ์ซอร์สโค้ดลง Output
local function buildGate()
	if not point1 then                                          -- ยังไม่ได้บันทึก Point 1
		print("[DevUtilityV2] ยังไม่ได้บันทึก Point 1 — กดปุ่ม 'บันทึก Point 1' ก่อน")
		return
	end
	if not rootPart then                                        -- ยังไม่มีตัวละคร
		print("[DevUtilityV2] ยังไม่มีตัวละคร — ยังสร้างประตูวาร์ปไม่ได้")
		return
	end
	point2 = rootPart.CFrame                                    -- บันทึกจุดปลายทาง (Exit) จากตำแหน่งที่ยืนอยู่
	local gate = Instance.new("Part")                           -- สร้าง Part สำหรับเป็นประตูวาร์ป
	gate.Name = "TeleportGate"                                  -- ตั้งชื่อประตู
	gate.Size = Vector3.new(8, 10, 1)                           -- รูปทรงประตู: กว้าง 8 สูง 10 หนา 1 สตั๊ด
	gate.Color = Color3.fromRGB(0, 140, 255)                    -- สีฟ้า
	gate.Transparency = 0.5                                     -- โปร่งแสง 50%
	gate.Material = Enum.Material.Neon                          -- วัสดุเรืองแสง ให้ดูเหมือนประตูวาร์ป
	gate.Anchored = true                                        -- ยึดค้างไว้ไม่ให้ตก
	gate.CanCollide = false                                     -- ไม่มีการชน เพื่อให้เดินเข้ากระตุ้นได้โดยไม่ติด
	-- วางประตูให้ตั้งอยู่บนพื้น โดยกะว่าพื้นอยู่ใต้จุดที่ยืน ~3 สตั๊ด (ความสูง RootPart โดยประมาณ)
	local floorPosition = point1.Position - Vector3.new(0, 3, 0)              -- ตำแหน่งพื้นโดยประมาณใต้จุดเริ่มต้น
	local gatePosition = floorPosition + Vector3.new(0, gate.Size.Y / 2, 0)   -- ยกกึ่งกลางประตูให้เท่ากับครึ่งความสูง
	local _, yaw = point1:ToEulerAnglesYXZ()                                  -- ดึงมุมหัน (Yaw) ของจุดเริ่มต้น
	gate.CFrame = CFrame.new(gatePosition) * CFrame.Angles(0, yaw, 0)         -- ตั้งตำแหน่ง + หันหน้าตามตัวละครตอนบันทึก
	gate.Parent = workspace                                       -- ใส่ประตูเข้า Workspace
	local source = buildGateSource(point2)                        -- สร้างซอร์สโค้ดสำหรับจุดปลายทางรอบนี้
	local gateScript = Instance.new("Script")                     -- สร้าง Script (server) เป็นลูกของประตู
	gateScript.Name = "TeleportGateHandler"                       -- ตั้งชื่อสคริปต์
	local sourceOK, sourceErr = pcall(function()                  -- พยายามใส่เนื้อหาสคริปต์ (อาจติดสิทธิ์ Plugin)
		gateScript.Source = source                                -- กำหนดเนื้อหาของ Script
	end)
	if not sourceOK then                                          -- เขียน Script.Source ไม่สำเร็จ
		local stash = Instance.new("StringValue")                  -- สร้าง StringValue สำรองเก็บซอร์ส
		stash.Name = "SourceCode_คัดลอกไปใส่ในScript"              -- ตั้งชื่อบอกวิธีใช้
		stash.Value = source                                      -- เก็บซอร์สโค้ดทั้งหมดไว้ในนี้
		stash.Parent = gate                                       -- ใส่ StringValue เข้าไปในประตู
		print("[DevUtilityV2] แจ้งเตือน: เขียน Script.Source ไม่ได้ (" .. tostring(sourceErr) .. ") → เก็บซอร์สไว้ใน StringValue แล้ว")
	end
	gateScript.Parent = gate                                      -- ใส่ Script เข้าไปใน Part ประตู
	gates[#gates + 1] = {                                         -- บันทึกข้อมูลประตูลงตาราง
		part = gate,                                              -- อ้างอิง Part ประตู
		exitCFrame = point2,                                      -- CFrame ปลายทาง
		lastTeleport = 0,                                         -- เวลาอนุญาตวาร์ปครั้งถัดไป (0 = วาร์ปได้ทันที)
	}
	print("[DevUtilityV2] สร้างประตูวาร์ปแล้ว | Point 1: " .. formatVector3(point1.Position) .. " | Point 2: " .. formatVector3(point2.Position))
	print("[DevUtilityV2] ===== ซอร์สโค้ดสคริปต์วาร์ป (คัดลอกไปวางใน Part ประตู) =====\n" .. source .. "\n[DevUtilityV2] ===== สิ้นสุดซอร์สโค้ด =====")
end

-- ล้าง Part ทดสอบและประตูวาร์ปทั้งหมดที่เสกออกมาทิ้ง
local function cleanUp()
	local removed = 0                                            -- ตัวนับจำนวนที่ลบ
	for i = #spawnedParts, 1, -1 do                              -- วนจากท้ายตารางของ Part ทดสอบ
		local part = spawnedParts[i]                             -- หยิบ Part แต่ละชิ้น
		if part and part.Parent then                             -- ถ้ายังอยู่ในเกม
			part:Destroy()                                       -- ทำลายทิ้ง
			removed = removed + 1                                -- นับจำนวน
		end
		spawnedParts[i] = nil                                    -- เคลียร์ค่าในตาราง
	end
	for i = #gates, 1, -1 do                                     -- วนจากท้ายตารางของประตูวาร์ป
		local gateInfo = gates[i]                                -- หยิบข้อมูลประตูแต่ละบาน
		if gateInfo.part and gateInfo.part.Parent then           -- ถ้าประตูยังอยู่ในเกม
			gateInfo.part:Destroy()                              -- ทำลายทั้งประตูและ Script ข้างใน
			removed = removed + 1                                -- นับจำนวน
		end
		gates[i] = nil                                           -- เคลียร์ค่าในตาราง
	end
	print("[DevUtilityV2] Clean Up: ลบ Instance ที่เสกออกมาทั้งหมดแล้ว " .. removed .. " ชิ้น")
end

-- บันทึกตำแหน่งปัจจุบันเป็น Waypoint ใหม่ (เพิ่มต่อท้ายลิสต์)
local function saveWaypoint()
	if not rootPart then                                         -- ยังไม่มีตัวละคร
		print("[DevUtilityV2] ยังไม่มีตัวละคร — ยังบันทึก Waypoint ไม่ได้")
		return
	end
	waypointCounter = waypointCounter + 1                        -- เพิ่มตัวนับชื่อจุด
	table.insert(waypoints, {                                    -- เพิ่มรายการใหม่เข้าตาราง
		name = "จุดที่ " .. waypointCounter,                      -- ชื่อจุด เช่น "จุดที่ 1"
		cFrame = rootPart.CFrame,                                 -- เก็บพิกัด+ทิศทางปัจจุบันไว้ใช้วาร์ปภายหลัง
	})
	rebuildWaypointList()                                        -- สร้างลิสต์ GUI ใหม่ให้แสดงจุดที่เพิ่ม
	refreshToggles()                                             -- อัปเดตป้ายจำนวนจุด
end

-- วาร์ปตัวละครไปยัง Waypoint ที่ระบุ (index = ลำดับในตาราง)
local function teleportToWaypoint(index)
	local wp = waypoints[index]                                  -- หยิบข้อมูลจุดนั้น
	if not wp or not rootPart then return end                    -- ไม่เจอจุดหรือไม่มีตัวละคร → จบ
	rootPart.CFrame = wp.cFrame                                  -- ย้ายตัวละครไปที่จุดที่บันทึกไว้ทันที
end

-- ลบทะเบียน Waypoint ที่ระบุ แล้วสร้างลิสต์ GUI ใหม่
local function deleteWaypoint(index)
	table.remove(waypoints, index)                               -- ลบรายการออกจากตาราง
	rebuildWaypointList()                                        -- สร้างลิสต์ GUI ใหม่
	refreshToggles()                                             -- อัปเดตป้ายจำนวนจุด
end

-- ===================== ระบบ Boost FPS (ลดกราฟฟิก/ปิดเอฟเฟก/ล้างหมอก/ปิดอนุภาค) =====================

-- เปิด Boost FPS: เก็บค่าเดิมไว้ใน boostBackup เพื่อใช้คืนสภาพตอนกดปิด
local function applyBoostFPS()
	if boostBackup then return "Boost FPS ทำงานอยู่แล้ว" end     -- กันเปิดซ้ำ
	local backup = {                                             -- ตารางเก็บค่าเดิมทั้งหมด
		quality = nil,                                           -- ค่า QualityLevel เดิม
		fogStart = Lighting.FogStart,                             -- ค่า FogStart เดิม
		fogEnd = Lighting.FogEnd,                                 -- ค่า FogEnd เดิม
		effects = {},                                            -- เอฟเฟก Lighting ที่ปิด {instance, originalEnabled}
		atmospheres = {},                                        -- Atmosphere ที่ปรับ {instance, originalDensity, originalOffset}
		particles = {},                                          -- ParticleEmitter ที่ปิด {instance, originalEnabled}
		beams = {},                                              -- Beam ที่ปิด {instance, originalEnabled}
		trails = {},                                             -- Trail ที่ปิด {instance, originalTransparency}
		materials = {},                                          -- วัสดุเดิมของ Part ที่เปลี่ยนเป็น SmoothPlastic {instance, originalMaterial}
		reflectances = {},                                       -- ค่าสะท้อนแสงเดิมที่ตั้งเป็น 0 {instance, originalReflectance}
		surfaceAppearances = {},                                 -- SurfaceAppearance ที่ปิด {instance, originalEnabled}
		textures = {},                                           -- Texture/Decal ที่ล้างรูป {instance, originalTexture}
		legacyEffects = {},                                      -- Fire/Smoke/Sparkles ที่ปิด {instance, originalEnabled}
		envSpecular = Lighting.EnvironmentSpecularScale,         -- ค่าสะท้อนสภาพแวดล้อมเดิม
		envDiffuse = Lighting.EnvironmentDiffuseScale,           -- ค่ากระจายแสงสภาพแวดล้อมเดิม
	}
	-- 1) ลดคุณภาพการเรนเดอร์ของเกม (วิธีเดียวที่ทำได้จากฝั่ง Client)
	pcall(function()                                             -- ครอบด้วย pcall กันสคริปต์ค้างถ้า API เปลี่ยน
		backup.quality = settings().Rendering.QualityLevel        -- เก็บค่า QualityLevel เดิมไว้ก่อน
		settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 -- ลดกราฟฟิกลงขั้นต่ำสุด
	end)
	-- 2) ปิดเอฟเฟกใน Lighting (Bloom/Blur/SunRays/ColorCorrection/DepthOfField) และล้างหมอก Atmosphere
	for _, child in ipairs(Lighting:GetChildren()) do             -- วนดู Instance ทุกตัวใน Lighting
		if child:IsA("PostEffect") then                           -- เอฟเฟกหลังเรนเดอร์ทุกชนิด
			table.insert(backup.effects, { instance = child, originalEnabled = child.Enabled }) -- เก็บค่าเดิม
			child.Enabled = false                                 -- ปิดเอฟเฟกตัวนี้
		elseif child:IsA("Atmosphere") then                       -- Atmosphere = หมอก/บรรยากาศลอยในอากาศ
			table.insert(backup.atmospheres, {                    -- เก็บค่าเดิมของ Atmosphere
				instance = child,
				originalDensity = child.Density,                  -- ความหนาแน่นหมอกเดิม
				originalOffset = child.Offset,                    -- ระยะกระจายหมอกเดิม
			})
			child.Density = 0                                     -- ลดความหนาแน่นหมอกเป็นศูนย์ (ล้างหมอก)
			child.Offset = 0                                      -- ลดระยะกระจายเป็นศูนย์
		end
	end
	Lighting.FogStart = 0                                        -- กำหนด FogStart = 0
	Lighting.FogEnd = 100000000                                  -- ดัน FogEnd ให้ไกลมาก → หมอกจางหาย มองเห็นชัดสุด (Fog คือระบบหมอกแบบเก่า)
	Lighting.EnvironmentSpecularScale = 0                        -- ปิดการสะท้อนสภาพแวดล้อม (ผิวดูแบนแบบดินน้ำมัน)
	Lighting.EnvironmentDiffuseScale = 0                         -- ปิดการกระจายแสงสภาพแวดล้อม (ผิวดูแบนสม่ำเสมอ)
	-- 3) ปิดอนุภาค/ลำแสง/ทางวิ่งทั่ว Workspace (ยกเว้นส่วนที่อยู่ในตัวละครของเรา)
	for _, inst in ipairs(workspace:GetDescendants()) do          -- วน Instance ทุกตัวใน Workspace
		if not (character and inst:IsDescendantOf(character)) then -- ข้ามส่วนของตัวละครตัวเอง
			if inst:IsA("ParticleEmitter") then                    -- อนุภาคควัน/ประกาย/แสง
				table.insert(backup.particles, { instance = inst, originalEnabled = inst.Enabled }) -- เก็บค่าเดิม
				inst.Enabled = false                              -- ปิดอนุภาคตัวนี้
			elseif inst:IsA("Beam") then                          -- ลำแสงเชื่อมระหว่าง Part
				table.insert(backup.beams, { instance = inst, originalEnabled = inst.Enabled }) -- เก็บค่าเดิม
				inst.Enabled = false                              -- ปิดลำแสงตัวนี้
			elseif inst:IsA("Trail") then                         -- ทางวิ่งท้ายตัวละคร/อาวุธ
				table.insert(backup.trails, { instance = inst, originalTransparency = inst.Transparency }) -- เก็บค่าเดิม
				inst.Transparency = NumberSequence.new(1)         -- ทำให้ Trail โปร่งใสสนิท (มองไม่เห็น)
			elseif inst:IsA("BasePart") and not inst:IsA("Terrain") then -- ส่วนดินน้ำมัน: เปลี่ยนวัสดุทุก Part (ไม่แตะ Terrain เพราะตั้งเป็น SmoothPlastic ไม่ได้)
				if inst.Material ~= Enum.Material.SmoothPlastic then -- ถ้ายังไม่ใช่ SmoothPlastic
					table.insert(backup.materials, { instance = inst, originalMaterial = inst.Material }) -- เก็บวัสดุเดิม
					inst.Material = Enum.Material.SmoothPlastic   -- เปลี่ยนเป็นผิวเรียบแบนแบบดินน้ำมัน
				end
				if inst.Reflectance > 0 then                       -- ถ้า Part มีค่าสะท้อนแสง
					table.insert(backup.reflectances, { instance = inst, originalReflectance = inst.Reflectance }) -- เก็บค่าเดิม
					inst.Reflectance = 0                          -- ปิดการสะท้อน → ผิวแบนสนิท
				end
			elseif inst:IsA("SurfaceAppearance") then             -- พื้นผิว PBR แบบคมชัด → ปิดให้ผิวแบน
				table.insert(backup.surfaceAppearances, { instance = inst, originalEnabled = inst.Enabled }) -- เก็บค่าเดิม
				inst.Enabled = false                              -- ปิดพื้นผิว PBR
			elseif inst:IsA("Texture") or inst:IsA("Decal") then  -- เท็กซ์เจอร์/สติ๊กเกอร์ตกแต่ง → ล้างรูปออก
				table.insert(backup.textures, { instance = inst, originalTexture = inst.Texture }) -- เก็บชื่อรูปเดิม
				inst.Texture = ""                                 -- ล้างรูปเท็กซ์เจอร์ (ผิวเปลือยเปล่า)
			elseif inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles") then -- เอฟเฟกโบราณ (ไฟ/ควัน/ประกาย) → ปิด
				table.insert(backup.legacyEffects, { instance = inst, originalEnabled = inst.Enabled }) -- เก็บค่าเดิม
				inst.Enabled = false                              -- ปิดเอฟเฟกตัวนี้
			end
		end
	end
	boostBackup = backup                                         -- บันทึกว่า Boost เปิดอยู่ + เก็บค่าเดิมไว้คืน
	-- คืนข้อความสรุปผลที่ทำทั้งหมด เพื่อแสดงบน GUI
	return string.format(                                        -- ต่อข้อความสรุป
		"เปิด Boost FPS (ดินน้ำมัน) แล้ว\nเปลี่ยนวัสดุ SmoothPlastic %d ชิ้น | ปิดผิว/เท็กซ์เจอร์/เอฟเฟกเก่า %d ชิ้น\nปิด PostEffect %d | Particle %d | Beam %d | Trail %d\nลด QualityLevel + ล้างหมอก + ปิดการสะท้อน เรียบร้อย",
		#backup.materials,                                        -- จำนวน Part ที่เปลี่ยนวัสดุเป็นดินน้ำมัน
		#backup.surfaceAppearances + #backup.textures + #backup.legacyEffects, -- จำนวนพื้นผิว/เท็กซ์เจอร์/เอฟเฟกโบราณที่ปิด
		#backup.effects, #backup.particles, #backup.beams, #backup.trails -- จำนวนเอฟเฟกอื่นที่ปิด
	)
end

-- ปิด Boost FPS: คืนสภาพกราฟฟิกเป็นค่าเดิมทุกอย่างที่เคยเปลี่ยนไว้
local function restoreBoostFPS()
	if not boostBackup then return "ยังไม่ได้เปิด Boost FPS อยู่" end -- ยังไม่เคยเปิด → จบ
	local b = boostBackup                                         -- หยิบตารางค่าเดิมมาใช้
	pcall(function()                                             -- คืน QualityLevel เดิม (กัน API พัง)
		if b.quality then settings().Rendering.QualityLevel = b.quality end -- คืนค่าคุณภาพกราฟฟิกเดิม
	end)
	for _, item in ipairs(b.effects) do                          -- วนเอฟเฟกที่เคยปิดไว้
		if item.instance.Parent then item.instance.Enabled = item.originalEnabled end -- คืนสถานะเปิด/ปิดเดิม
	end
	for _, item in ipairs(b.atmospheres) do                      -- วน Atmosphere ที่เคยปรับไว้
		if item.instance.Parent then                             -- ถ้ายังอยู่ในเกม
			item.instance.Density = item.originalDensity          -- คืนความหนาแน่นหมอกเดิม
			item.instance.Offset = item.originalOffset            -- คืนระยะกระจายหมอกเดิม
		end
	end
	Lighting.FogStart = b.fogStart                               -- คืนค่า FogStart เดิม
	Lighting.FogEnd = b.fogEnd                                   -- คืนค่า FogEnd เดิม
	for _, item in ipairs(b.particles) do                        -- วน ParticleEmitter ที่เคยปิดไว้
		if item.instance.Parent then item.instance.Enabled = item.originalEnabled end -- คืนสถานะเปิด/ปิดเดิมของอนุภาคแต่ละตัว
	end
	for _, item in ipairs(b.beams) do                            -- วน Beam ที่เคยปิดไว้
		if item.instance.Parent then item.instance.Enabled = item.originalEnabled end -- คืนสถานะเดิม
	end
	for _, item in ipairs(b.trails) do                           -- วน Trail ที่เคยปิดไว้
		if item.instance.Parent then item.instance.Transparency = item.originalTransparency end -- คืนค่าความโปร่งใสเดิม
	end
	for _, item in ipairs(b.materials) do                        -- วน Part ที่เคยเปลี่ยนเป็นดินน้ำมัน
		if item.instance.Parent then item.instance.Material = item.originalMaterial end -- คืนวัสดุเดิมทุกชิ้น
	end
	for _, item in ipairs(b.reflectances) do                     -- วน Part ที่เคยปิดการสะท้อน
		if item.instance.Parent then item.instance.Reflectance = item.originalReflectance end -- คืนค่าสะท้อนแสงเดิม
	end
	for _, item in ipairs(b.surfaceAppearances) do               -- วน SurfaceAppearance ที่เคยปิด
		if item.instance.Parent then item.instance.Enabled = item.originalEnabled end -- คืนสถานะเดิม
	end
	for _, item in ipairs(b.textures) do                         -- วน Texture/Decal ที่เคยล้างรูป
		if item.instance.Parent then item.instance.Texture = item.originalTexture end -- คืนรูปเท็กซ์เจอร์เดิม
	end
	for _, item in ipairs(b.legacyEffects) do                    -- วน Fire/Smoke/Sparkles ที่เคยปิด
		if item.instance.Parent then item.instance.Enabled = item.originalEnabled end -- คืนสถานะเดิม
	end
	Lighting.EnvironmentSpecularScale = b.envSpecular            -- คืนค่าสะท้อนสภาพแวดล้อมเดิม
	Lighting.EnvironmentDiffuseScale = b.envDiffuse              -- คืนค่ากระจายแสงสภาพแวดล้อมเดิม
	boostBackup = nil                                            -- เคลียร์สถานะ Boost
	return "คืนสภาพกราฟฟิกเดิมเรียบร้อยแล้ว"                     -- คืนข้อความยืนยัน
end

-- วาร์ปตัวละครไปยังจุดที่เมาส์ชี้ (คีย์ T หรือปุ่มในเมนู) — ยกขึ้น 3 สตั๊ดกันจมลงพื้น และรักษาทิศทางเดิม
local function teleportToMouse()
	local hit = getMouseHit()                                    -- ยิง Ray หาจุดที่เมาส์ชี้
	if rootPart and hit then                                     -- มีทั้งตัวละครและจุดที่ชี้เจอ
		local targetPosition = hit.Position + Vector3.new(0, 3, 0) -- ยกขึ้น 3 สตั๊ด กันตัวละครจมลงในพื้น
		local currentCFrame = rootPart.CFrame                    -- เก็บ CFrame ปัจจุบันไว้ต่อท้าย
		rootPart.CFrame = CFrame.new(targetPosition) * (currentCFrame - currentCFrame.Position) -- วาร์ปแบบคงทิศทางเดิมไว้
		print("[DevUtilityV2] วาร์ปไปยัง " .. formatVector3(targetPosition))
	elseif not hit then                                          -- ชี้ไปที่ว่าง (ไม่โดนวัตถุ)
		print("[DevUtilityV2] ไม่พบพื้นผิวที่เมาส์ชี้ — ยังวาร์ปไม่ได้")
	else                                                         -- ยังไม่มีตัวละคร
		print("[DevUtilityV2] ยังไม่มีตัวละคร")
	end
end

