-- ฟังก์ชันช่วย: สร้างสไลเดอร์ (แถบให้ลากจุดกลมเลื่อนปรับค่า) พร้อมป้ายชื่อ + ค่าปัจจุบัน
local function makeSlider(parent, containerY, labelText, minValue, maxValue, initialValue, onChange)
	local value = initialValue                                        -- ค่าปัจจุบันของสไลเดอร์
	local fraction = (initialValue - minValue) / (maxValue - minValue) -- ตำแหน่งหัวสไลเดอร์เป็นสัดส่วน 0-1

	local container = Instance.new("Frame")                         -- กรอบรวมป้าย + แถบสไลเดอร์
	container.Size = UDim2.new(1, 0, 0, 44)                         -- กว้างเต็มความกว้าง สูง 44px
	container.Position = UDim2.new(0, 0, 0, containerY)             -- ตำแหน่งแนวตั้งที่ส่งเข้ามา
	container.BackgroundTransparency = 1                            -- ไม่มีพื้นหลัง
	container.Parent = parent                                       -- ใส่เข้าแท็บตัวละคร

	local caption = Instance.new("TextLabel")                       -- ป้ายชื่อ + ค่าปัจจุบัน (เช่น "ความเร็ววิ่ง: 50")
	caption.Size = UDim2.new(1, 0, 0, 18)                           -- สูง 18px
	caption.BackgroundTransparency = 1                              -- ไม่มีพื้นหลัง
	caption.Font = FONT                                             -- ฟอนต์เดียวกับเมนู
	caption.TextSize = 13                                           -- ขนาดตัวอักษร
	caption.TextColor3 = COLOR_TEXT                                 -- สีตัวอักษร
	caption.TextXAlignment = Enum.TextXAlignment.Left               -- ชิดซ้าย
	caption.Text = labelText .. ": " .. value                       -- ข้อความเริ่มต้น
	caption.Parent = container                                      -- ใส่เข้ากรอบ

	local track = Instance.new("Frame")                             -- แถบรางสไลเดอร์
	track.Size = UDim2.new(1, 0, 0, 8)                              -- เต็มความกว้าง สูง 8px
	track.Position = UDim2.new(0, 0, 0, 30)                         -- อยู่ใต้ป้าย
	track.BackgroundColor3 = COLOR_BTN                              -- สีพื้นราง
	track.BorderSizePixel = 0                                       -- ปิดเส้นขอบ
	track.Parent = container                                        -- ใส่เข้ากรอบ
	addCorner(track, 4)                                             -- ทำมุมโค้งราง

	local fill = Instance.new("Frame")                              -- ส่วนซ้ายของราง (สีเน้น บอกว่าปรับไปถึงไหน)
	fill.Size = UDim2.new(fraction, 0, 1, 0)                         -- ความยาวตามสัดส่วนค่าปัจจุบัน
	fill.BackgroundColor3 = COLOR_ACCENT                            -- สีเน้น
	fill.BorderSizePixel = 0                                        -- ปิดเส้นขอบ
	fill.Parent = track                                             -- ใส่เข้าราง
	addCorner(fill, 4)                                              -- ทำมุมโค้ง

	local knob = Instance.new("TextButton")                         -- หัวสไลเดอร์ (จุดกลมที่ใช้ลาก)
	knob.Size = UDim2.new(0, 18, 0, 18)                             -- ขนาด 18x18 px
	knob.Position = UDim2.new(fraction, -9, 0.5, -9)                 -- วางตามสัดส่วน กึ่งกลางแนวตั้ง
	knob.BackgroundColor3 = COLOR_TEXT                              -- สีจุดกลม (ตัดกับราง)
	knob.Text = ""                                                  -- ไม่มีข้อความ
	knob.AutoButtonColor = false                                    -- ปิดเอฟเฟกต์กดของ Roblox
	knob.Parent = track                                             -- ใส่เข้าราง (เป็นลูกของราง เพื่อเลื่อนตามราง)
	addCorner(knob, 9)                                              -- ทำมุมโค้งเต็ม (เป็นวงกลม)

	local isDragging = false                                        -- สถานะว่ากำลังลากหัวสไลเดอร์อยู่หรือไม่

	-- ตั้งค่าจากสัดส่วน 0-1 (ใช้ทั้งตอนลากและตอนตั้งค่าเริ่มต้น)
	local function setFromFraction(newFraction)
		fraction = math.clamp(newFraction, 0, 1)                     -- จำกัดไม่ให้หลุดขอบราง
		value = math.floor(minValue + (maxValue - minValue) * fraction + 0.5) -- แปลงเป็นจำนวนเต็มในช่วง min-max
		fill.Size = UDim2.new(fraction, 0, 1, 0)                     -- ขยายแถบสีเน้นตามสัดส่วน
		knob.Position = UDim2.new(fraction, -9, 0.5, -9)             -- เลื่อนหัวสไลเดอร์ตามสัดส่วน
		caption.Text = labelText .. ": " .. value                    -- อัปเดตตัวเลขบนป้าย
		if onChange then onChange(value) end                         -- แจ้งค่าใหม่ให้ระบบข้างนอก (ใช้กับ WalkSpeed ทันที)
	end

	-- แปลงตำแหน่งเมาส์บนหน้าจอเป็นสัดส่วนบนแถบราง
	local function fractionFromInput(input)
		local trackWidth = math.max(track.AbsoluteSize.X, 1)         -- ความกว้างรางปัจจุบัน (กันหารศูนย์)
		return (input.Position.X - track.AbsolutePosition.X) / trackWidth -- ระยะจากขอบซ้ายราง ÷ ความกว้างราง
	end

	knob.MouseButton1Down:Connect(function() isDragging = true end) -- เริ่มลากเมื่อกดที่หัวสไลเดอร์
	track.InputBegan:Connect(function(input)                        -- คลิกที่ราง → กระโดดค่าไปตำแหน่งที่คลิก + เริ่มลาก
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			isDragging = true
			setFromFraction(fractionFromInput(input))
		end
	end)
	UserInputService.InputChanged:Connect(function(input)           -- ทุกครั้งที่ input เปลี่ยน (เมาส์ขยับ)
		if isDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			setFromFraction(fractionFromInput(input))               -- ปรับค่าตามตำแหน่งเมาส์ปัจจุบัน
		end
	end)
	UserInputService.InputEnded:Connect(function(input)             -- ปล่อยคลิก → หยุดลาก
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			isDragging = false
		end
	end)

	setFromFraction(fraction)                                      -- ตั้งค่าเริ่มต้นให้ตรงกับค่าที่ส่งเข้ามา
	return { caption = caption, setFromFraction = setFromFraction } -- คืน object ไว้ให้ UI ส่วนอื่นอัปเดตป้ายได้
end

