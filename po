-- ===================== จัดการตัวละคร (รันใหม่ทุกครั้งที่ตัวละครเกิด) =====================
local function onCharacterAdded(newCharacter)
	character = newCharacter                                      -- เก็บ Model ตัวละครตัวใหม่
	rootPart = newCharacter:WaitForChild("HumanoidRootPart", 10)  -- รอ Part หลักของตัวละคร (สูงสุด 10 วิ)
	humanoid = newCharacter:WaitForChild("Humanoid", 10)          -- รอ Humanoid (สูงสุด 10 วิ)
	if humanoid then                                             -- ถ้าหา Humanoid เจอ
		if speedMode then                                        -- ถ้าผู้ใช้เปิดโหมดวิ่งเร็วไว้
			humanoid.WalkSpeed = walkSpeedValue                  -- คงความเร็วเดิมไว้ข้ามการเกิดใหม่ (ไม่รีเซ็ตเป็น 16)
		else                                                     -- ถ้าปิดโหมดวิ่งเร็วอยู่
			humanoid.WalkSpeed = WALK_DEFAULT                    -- ตั้งเป็นค่าปกติของ Roblox
		end
		humanoid.AutoRotate = not flyEnabled                      -- ถ้ากำลังบินอยู่ให้ปิดการหมั่นหน้าอัตโนมัติ
	end
	-- * โหมดวิ่งเร็ว/NoClip/บิน ไม่รีเซ็ตเมื่อเกิดใหม่ เพราะเป็นสวิตช์ที่ผู้ใช้เปิดไว้
	if refreshToggles then refreshToggles() end                  -- อัปเดตป้าย UI ให้ตรงกับสถานะใหม่
end

player.CharacterAdded:Connect(onCharacterAdded)                 -- ผูกฟังก์ชันกับอีเวนต์ "ตัวละครเกิดใหม่"
if player.Character then                                        -- ถ้าตัวละครมีอยู่แล้ว (สคริปต์รันช้ากว่า)
	onCharacterAdded(player.Character)                           -- เรียกใช้ทันทีเพื่ออ้างอิงตัวละครเดิม
end

-- ===================== เอฟเฟกต์ Fade หน้าจอดำ (ใช้ตอนวาร์ปประตู) =====================
local FADE_DURATION = 0.3                                        -- ระยะเวลา Fade 1 รอบ (วินาที)

-- ทำเอฟเฟกต์จอดำ → รันงานที่ส่งมา (action) → จอกลับใส → ลบ GUI ทิ้ง
local function fadeOverlay(action)
	local gui = Instance.new("ScreenGui")                        -- สร้าง GUI ชั่วคราวสำหรับจอดำ
	gui.Name = "DevUtilityV2FadeGui"                             -- ตั้งชื่อ GUI
	gui.IgnoreGuiInset = true                                    -- ครอบคลุมถึงแถบ UI ด้านบน
	gui.ResetOnSpawn = false                                     -- ไม่ให้หายตอนตัวละครเกิดใหม่
	gui.DisplayOrder = 1000                                      -- ให้แสดงทับ GUI อื่นทั้งหมด
	local frame = Instance.new("Frame")                          -- กรอบสีดำเต็มจอ
	frame.Size = UDim2.fromScale(1, 1)                           -- ครอบคลุมทั้งจอ
	frame.BackgroundColor3 = Color3.new(0, 0, 0)                 -- สีดำสนิท
	frame.BackgroundTransparency = 1                             -- เริ่มโปร่งใส 100% (ยังมองไม่เห็น)
	frame.BorderSizePixel = 0                                    -- ปิดเส้นขอบ
	frame.Parent = gui                                           -- ใส่ Frame เข้า GUI
	gui.Parent = playerGui                                       -- ใส่ GUI เข้า PlayerGui ของเรา
	local fadeIn = TweenService:Create(                          -- สร้าง Tween สำหรับ Fade เข้า
		frame,
		TweenInfo.new(FADE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ BackgroundTransparency = 0 }                           -- ค่าปลายทาง = ทึบสนิท (ดำ)
	)
	fadeIn:Play()                                                -- เริ่ม Fade เข้า
	fadeIn.Completed:Wait()                                      -- รอจนจอดำสนิท
	if action then                                               -- ถ้ามีงานต้องทำระหว่างจอดำ (การวาร์ป)
		action()                                                 -- รันงานนั้น เช่น ย้ายตัวละคร
	end
	local fadeOut = TweenService:Create(                         -- สร้าง Tween สำหรับ Fade ออก
		frame,
		TweenInfo.new(FADE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ BackgroundTransparency = 1 }                           -- ค่าปลายทาง = โปร่งใส 100%
	)
	fadeOut:Play()                                               -- เริ่ม Fade ออก
	fadeOut.Completed:Wait()                                     -- รอจนจอใสสนิท
	gui:Destroy()                                                -- ลบ GUI ชั่วคราวทิ้ง
end

-- ===================== ฟังก์ชันระบบตัวละคร =====================

-- โหมดวิ่งเร็ว: เปิด = ตั้ง WalkSpeed เป็นค่าที่ผู้ใช้เลือก + รีเลือดเต็ม / ปิด = คืนค่าปกติ 16
local function setSpeedMode(enabled)
	speedMode = enabled                                          -- อัปเดตสถานะโหมดวิ่งเร็ว
	-- ถ้าตัวแปร humanoid ยังไม่มีค่า (หรือตัวละครเพิ่งตาย/เกิดใหม่) ให้ลองหาใหม่จากตัวละครปัจจุบัน
	if not humanoid or not humanoid.Parent then
		humanoid = character and character:FindFirstChildOfClass("Humanoid")
	end
	if not humanoid then                                         -- ยังหา Humanoid ไม่เจอจริง ๆ
		print("[DevUtilityV2] ยังไม่พบ Humanoid — ยังปรับความเร็วไม่ได้ (สถานะจำไว้ก่อน ลูป Heartbeat จะลองใหม่เอง)")
		return                                                   -- จบ แต่ speedMode คงไว้ให้ลูป apply เองทีหลัง
	end
	if speedMode then                                            -- ถ้าเปิดโหมดวิ่งเร็ว
		humanoid.WalkSpeed = walkSpeedValue                      -- ตั้งความเร็ววิ่งตามค่าที่เลือกในเมนู
		humanoid.Health = humanoid.MaxHealth                     -- รีเลือดกลับมาเต็มหลอด
		print("[DevUtilityV2] เปิดโหมดวิ่งเร็ว → WalkSpeed = " .. tostring(walkSpeedValue))
	else                                                         -- ถ้าปิดโหมดวิ่งเร็ว
		humanoid.WalkSpeed = WALK_DEFAULT                        -- คืนค่าความเร็วเป็นค่าปกติ 16
		print("[DevUtilityV2] ปิดโหมดวิ่งเร็ว → WalkSpeed = " .. tostring(WALK_DEFAULT))
	end
end

-- โหมด NoClip: เปิด = ปิดการชนของตัวละครทุกเฟรม / ปิด = คืนค่าการชน
local function setNoClip(enabled)
	noClipEnabled = enabled                                      -- อัปเดตสถานะ NoClip
	if not noClipEnabled and character then                      -- เพิ่งปิด NoClip และมีตัวละคร
		for _, part in ipairs(character:GetDescendants()) do      -- วนทุก Instance ในตัวละคร
			if part:IsA("BasePart") then                          -- เฉพาะ Part ที่มีรูปร่าง
				part.CanCollide = true                           -- คืนค่าให้ชนของแข็งได้ตามปกติ
			end
		end
	end
end

-- โหมดบิน: ขยับตัวละครตามกล้องด้วย WASD + Space ขึ้น / Ctrl ลง โดยยกเลิกแรงโน้มถ่วงทุกเฟรม
local function setFly(enabled)
	flyEnabled = enabled                                         -- อัปเดตสถานะโหมดบิน
	if flyConnection then                                        -- ถ้ามีลูปบินค้างอยู่ (จากครั้งก่อน)
		flyConnection:Disconnect()                               -- ตัดลูปบินเดิมทิ้ง
		flyConnection = nil                                      -- เคลียร์ค่า connection
	end
	if humanoid then                                             -- ถ้ามี Humanoid
		humanoid.AutoRotate = not flyEnabled                     -- ปิดการหมั่นหน้าอัตโนมัติระหว่างบิน
	end
	if flyEnabled and rootPart then                              -- ถ้าเพิ่งเปิดบินและมีตัวละคร
		flyConnection = RunService.RenderStepped:Connect(function(deltaTime)
			if not (flyEnabled and rootPart and rootPart.Parent) then return end -- เช็คว่ายังบินอยู่และตัวภาพยังอยู่
			rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0) -- หักล้างแรงทุกอย่าง (รวมแรงโน้มถ่วง) ให้ลอยค้างก่อน
			local cam = workspace.CurrentCamera                   -- ดึงกล้องปัจจุบัน
			if not cam then return end                           -- ไม่มีกล้อง → จบเฟรมนี้
			local moveDirection = Vector3.new(0, 0, 0)           -- ทิศทางที่จะบิน (เริ่มเป็นศูนย์)
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + cam.CFrame.LookVector end -- บินไปข้างหน้าตามกล้อง
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - cam.CFrame.LookVector end -- บินถอยหลังตามกล้อง
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + cam.CFrame.RightVector end -- บินไปขวาตามกล้อง
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - cam.CFrame.RightVector end -- บินไปซ้ายตามกล้อง
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection = moveDirection + Vector3.new(0, 1, 0) end -- บินขึ้น
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDirection = moveDirection - Vector3.new(0, 1, 0) end -- บินลง
			if moveDirection.Magnitude > 0 then                   -- ถ้ามีการกดปุ่มทิศทาง
				rootPart.CFrame = rootPart.CFrame + moveDirection.Unit * flySpeed * deltaTime -- ขยับตัวละครตามทิศทาง×ความเร็ว×เวลา
			end
		end)
	end
end

-- ===================== ระบบ Aimbot / ล็อกเป้าหมาย (สำหรับทดสอบระบบเล็งในเกมของตัวเอง) =====================

-- ตารางจุดเล็งที่เลือกได้ (วนด้วยปุ่มในเมนูแท็บ Aimbot)
local AIM_PARTS = {
	{ key = "Head", label = "ศีรษะ (Head)" },                      -- หัว (มีทั้ง R6 และ R15)
	{ key = "UpperTorso", label = "ลำตัวบน (UpperTorso)" },        -- ลำตัวบน (ตัวละคร R15 เท่านั้น)
	{ key = "HumanoidRootPart", label = "กลางลำตัว (HRP)" },       -- กลางลำตัว (มีทุกตัวละคร)
}

-- สแกนหาเป้าหมาย (Model ที่มี Humanoid ยังมีชีวิต) ทั่ว Workspace — เรียกซ้ำทุก 0.25 วินาที
local function refreshAimCandidates()
	aimCandidates = {}                                            -- ล้างรายการเป้าหมายเก่า
	for _, inst in ipairs(workspace:GetDescendants()) do           -- วน Instance ทุกตัวใน Workspace
		if inst:IsA("Model") then                                -- เฉพาะ Model เท่านั้น
			local hum = inst:FindFirstChildOfClass("Humanoid")   -- หา Humanoid ที่อยู่ใน Model นี้
			if hum and hum.Health > 0 and inst ~= character then -- มี Humanoid + ยังไม่ตาย + ไม่ใช่ตัวละครเราเอง
				table.insert(aimCandidates, { model = inst, humanoid = hum }) -- เพิ่มเข้ารายการเป้าหมาย
			end
		end
	end
end

-- หา Part ของเป้าหมายตามจุดเล็งที่ผู้ใช้เลือก (ถ้าไม่มีจุดนั้นให้ใช้ HumanoidRootPart แทน)
local function getAimPart(model)
	local wanted = AIM_PARTS[aimPartIndex].key                   -- ชื่อ Part ที่เลือกไว้ในเมนู
	local part = model:FindFirstChild(wanted)                     -- ลองหาจุดที่เลือก
	if part then return part end                                 -- เจอ → ใช้จุดนั้น
	return model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") -- ไม่เจอ → ใช้จุดสำรอง
end

-- คำนวณมุมกึ่งกลางของ FOV (องศา) ใช้ทั้งตอนเช็คเป้าและตอนวาดวงกลม
local function halfFovDegrees()
	return aimFov * 0.5                                          -- ครึ่งหนึ่งของค่า FOV ที่ตั้งไว้
end

-- วาดวงกลมแสดงขอบเขต Aimbot กลางจอ (อัปเดตเมื่อเปลี่ยนค่า FOV หรือตอนเปิด Aimbot)
local function updateFovCircle()
	if not fovCircle then return end                             -- ยังสร้าง GUI ไม่เสร็จ → ข้ามไปก่อน
	local cam = workspace.CurrentCamera                          -- ดึงกล้องปัจจุบัน
	local viewport = (cam and cam.ViewportSize) or Vector2.new(1920, 1080) -- ขนาดหน้าจอปัจจุบัน (มีค่าสำรองถ้าไม่มีกล้อง)
	local verticalFov = (cam and cam.FieldOfView) or 70          -- มุมมองแนวตั้งของกล้อง (ค่าปกติของ Roblox คือ 70)
	-- แปลงมุม FOV (องศา) เป็นเส้นผ่านศูนย์กลางวงกลมบนหน้าจอ (หน่วย Pixel)
	local diameter = 2 * math.tan(math.rad(halfFovDegrees())) * (viewport.Y * 0.5) / math.tan(math.rad(verticalFov * 0.5))
	diameter = math.floor(math.clamp(diameter, 20, 4000))        -- จำกัดขนาดไม่ให้เล็กหรือใหญ่เกินไป
	fovCircle.Size = UDim2.new(0, diameter, 0, diameter)         -- ตั้งขนาดวงกลมตามค่าที่คำนวณได้
	fovCircle.Position = UDim2.new(0.5, -diameter / 2, 0.5, -diameter / 2) -- วางกึ่งกลางหน้าจอพอดี
end

-- ฟังก์ชันหลักของ Aimbot (รันทุกเฟรม หลังกล้องอัปเดตแล้ว) — หาเป้าหมายในกรอบ FOV แล้วหมุนกล้องไปหาแบบนุ่มนวล
local function aimbotStep()
	local cam = workspace.CurrentCamera
	if not (aimbotEnabled and cam) then return end              -- ปิดอยู่หรือไม่มีกล้อง → จบเฟรมนี้
	local camCF = cam.CFrame                                     -- CFrame ของกล้องปัจจุบัน
	local camPos = camCF.Position                                -- ตำแหน่งกล้องในโลก
	local halfFovRad = math.rad(halfFovDegrees())                -- ครึ่ง FOV แปลงเป็นเรเดียน
	local bestPart, bestAngle = nil, nil                         -- เป้าหมายที่ดีที่สุด (มุมแคบที่สุด)
	local rayParams = RaycastParams.new()                        -- ตั้งค่า Raycast สำหรับเช็คการมองเห็น
	rayParams.FilterType = Enum.RaycastFilterType.Exclude        -- โหมดยกเว้น Instance ที่ระบุ
	rayParams.FilterDescendantsInstances = { character }         -- ไม่ให้ Ray โดนตัวละครของเราเอง
	for _, cand in ipairs(aimCandidates) do                       -- วนเป้าหมายทั้งหมดที่สแกนไว้
		local model = cand.model                                -- Model ของเป้าหมายตัวนี้
		if model.Parent and cand.humanoid.Health > 0 then       -- ยังอยู่ในเกมและยังไม่ตาย
			local part = getAimPart(model)                      -- Part จุดเล็งของเป้าหมายนี้
			if part then
				local toTarget = part.Position - camPos         -- ทิศทางจากกล้องไปยังเป้า
				local distance = toTarget.Magnitude             -- ระยะทางเป็นหน่วยสตั๊ด
				if distance > 0.5 and distance <= aimRange then -- อยู่ในระยะที่กำหนด (ไม่นับระยะใกล้กว่า 0.5)
					local direction = toTarget / distance       -- ทิศทาง Normalize (ยาว 1)
					local angle = math.acos(math.clamp(camCF.LookVector:Dot(direction), -1, 1)) -- มุมระหว่างสายตากับเป้า (เรเดียน)
					if angle <= halfFovRad                       -- อยู่ในกรอบ FOV
						and (bestAngle == nil or angle < bestAngle) then -- และมุมแคบกว่าเป้าหมายเดิม
						local visible = true                     -- สมมติว่ามองเห็นก่อน
						if aimVisibility then                   -- ถ้าเปิดโหมดมองเห็นเท่านั้น
							local result = workspace:Raycast(camPos, toTarget, rayParams) -- ยิง Ray จากกล้องไปหาเป้า
							if result then                      -- มีอะไรขวางทาง
								visible = (result.Instance == part)                     -- โดนตัว Part เป้าเอง
									or result.Instance:IsDescendantOf(model)            -- หรืออยู่ใน Model เป้า
									or (result.Position - camPos).Magnitude >= distance - 1 -- หรือจุดที่โดนอยู่ไกลกว่าเป้า (อยู่หลังเป้า)
							end
						end
						if visible then
							bestPart, bestAngle = part, angle   -- จำเป้าหมายที่ดีที่สุดไว้
						end
					end
				end
			end
		end
	end
	if bestPart then                                            -- เจอเป้าหมายที่จะเล็ง
		local desiredCF = CFrame.lookAt(camPos, bestPart.Position, camCF.UpVector) -- CFrame ที่ต้องการ (กล้องหันไปหาเป้า)
		local blend = math.clamp(aimSmooth / 100, 0.05, 1)      -- ค่าความไว (0.05 = นุ่มมาก, 1 = ตามทันที)
		cam.CFrame = camCF:Lerp(desiredCF, blend)                -- หมุนกล้องไปหาเป้าแบบค่อย ๆ เลื่อน
	end
end

-- เปิด/ปิด Aimbot: ผูก/ถอนลูปเล็งจาก RenderStep + แสดง/ซ่อนวงกลม FOV
local function setAimbot(enabled)
	aimbotEnabled = enabled                                     -- อัปเดตสถานะ Aimbot
	if aimbotEnabled then
		refreshAimCandidates()                                   -- สแกนเป้าหมายทันทีตอนเปิด
		RunService:UnbindFromRenderStep(aimBindName)             -- กัน Bind ซ้ำ (ถ้าเคยผูกไว้แล้วให้ถอดก่อน)
		-- BindToRenderStep ลำดับหลังกล้อง (Camera+1) เพื่อให้ทับการหมุนกล้องของเกมในเฟรมเดียวกัน
		RunService:BindToRenderStep(aimBindName, Enum.RenderPriority.Camera.Value + 1, aimbotStep)
		updateFovCircle()                                       -- คำนวณขนาดวงกลม FOV ตามค่าปัจจุบัน
		if fovCircle then fovCircle.Visible = true end           -- แสดงวงกลม FOV กลางจอ
	else
		RunService:UnbindFromRenderStep(aimBindName)             -- ถอนลูปเล็งออก
		if fovCircle then fovCircle.Visible = false end          -- ซ่อนวงกลม FOV
	end
end

